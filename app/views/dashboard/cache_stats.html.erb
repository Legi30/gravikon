<div class="page-header">
  <h1>📊 Statistiky cache</h1>
  <p style="color: rgba(255, 255, 255, 0.8); margin-top: 0.5rem;">Sledování efektivity cache dat soustav a galaxie v reálném čase</p>
</div>

<div class="content-section">
  <% if @cache_report[:cache_hit_rate].to_f >= 70 %>
    <div class="card fade-in">
      ✅ <strong>Výkon cache: výborný</strong> — úspěšnost je <%= @cache_report[:cache_hit_rate] %> (cíl: &gt;70 %)
    </div>
  <% elsif @cache_report[:cache_hit_rate].to_f > 0 %>
    <div class="card fade-in">
      ⚠️ <strong>Výkon cache: pod cílem</strong> — úspěšnost je <%= @cache_report[:cache_hit_rate] %> (cíl: &gt;70 %). Zvažte kontrolu frekvence invalidace cache.
    </div>
  <% else %>
    <div class="card fade-in">
      ℹ️ <strong>Žádná aktivita cache</strong> — zatím nebyly zaznamenány žádné požadavky. Navštivte několik stránek pro sběr metrik.
    </div>
  <% end %>
</div>

<div class="content-section">
  <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
    <div class="card stat-card">
      <div class="stat-label">Úspěšnost cache</div>
      <div class="stat-value"><%= @cache_report[:cache_hit_rate] %></div>
      <div class="stat-detail">Cíl: &gt;70 %</div>
    </div>

    <div class="card stat-card">
      <div class="stat-label">Zásahy (hits)</div>
      <div class="stat-value"><%= @cache_report[:total_hits] %></div>
      <div class="stat-detail">Obslouženo z paměti</div>
    </div>

    <div class="card stat-card">
      <div class="stat-label">Miny (misses)</div>
      <div class="stat-value"><%= @cache_report[:total_misses] %></div>
      <div class="stat-detail">Vyžadovaly čtení z disku</div>
    </div>

    <div class="card stat-card">
      <div class="stat-label">Ušetřený čas</div>
      <div class="stat-value"><%= (@time_saved / 1000).round(2) %> s</div>
      <div class="stat-detail">Zrychlení o <%= @performance_gain %> %</div>
    </div>
  </div>
</div>

<div class="content-section">
  <div class="card fade-in">
    <h3>📈 Kumulativní dopad na výkon</h3>
    <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
      <tr style="border-bottom: 2px solid rgba(255,255,255,0.2);">
        <th style="text-align: left; padding: 12px;">Metrika</th>
        <th style="text-align: right; padding: 12px;">Hodnota</th>
      </tr>
      <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
        <td style="padding: 12px;">Celkem požadavků</td>
        <td style="text-align: right; padding: 12px; font-weight: bold;"><%= @cache_stats[:hits] + @cache_stats[:misses] %></td>
      </tr>
      <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
        <td style="padding: 12px;">Průměrný čas bez cache</td>
        <td style="text-align: right; padding: 12px; font-weight: bold;"><%= @cache_report[:average_fetch_time_ms] %> ms</td>
      </tr>
      <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
        <td style="padding: 12px;">Průměrný čas s cache</td>
        <td style="text-align: right; padding: 12px; font-weight: bold; color: #2ed573;"><%= @cache_report[:average_cache_read_time_ms] %> ms</td>
      </tr>
      <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
        <td style="padding: 12px;">Celkem ušetřeno</td>
        <td style="text-align: right; padding: 12px; font-weight: bold; color: #f5576c;"><%= @time_saved.round(2) %> ms</td>
      </tr>
      <tr>
        <td style="padding: 12px;">Zlepšení výkonu</td>
        <td style="text-align: right; padding: 12px; font-weight: bold; color: #667eea;"><%= @performance_gain %> %</td>
      </tr>
    </table>
  </div>
</div>

<div class="content-section">
  <div class="card fade-in">
    <h3>ℹ️ Informace o měření</h3>
    <p><strong>Měření zahájeno:</strong> <%= @cache_report[:last_reset] %></p>
    <p><strong>Délka měření:</strong> <%= (@cache_report[:monitoring_duration] / 60).round(2) %> minut</p>
    <p><strong>Sledované klíče:</strong> system_data*, galaxy_data*</p>
    <p><strong>Cache store:</strong> <%= Rails.cache.class.name %></p>
  </div>
</div>

<nav class="actions" role="navigation">
  <%= link_to "← Zpět na přehled", dashboard_path, class: "btn btn-secondary" %>
  <%= link_to "Zobrazit jako JSON", dashboard_cache_stats_path(format: :json), class: "btn btn-secondary", target: "_blank" %>
</nav>

<style>
  .stat-card .stat-label {
    font-size: 0.9em;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }

  .stat-card .stat-value {
    font-size: 2.2em;
    font-weight: bold;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }

  .stat-card .stat-detail {
    font-size: 0.85em;
    opacity: 0.7;
  }
</style>
