<!DOCTYPE html>
<html>
<head>
  <title>Cache Performance Statistics - Gravikon</title>
  <%= stylesheet_link_tag "gravikon" %>
  <style>
    .cache-stats-container {
      max-width: 1200px;
      margin: 40px auto;
      padding: 20px;
    }

    .stats-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .stat-card {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .stat-card.success {
      background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
    }

    .stat-card.warning {
      background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }

    .stat-card.info {
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    }

    .stat-label {
      font-size: 0.9em;
      opacity: 0.9;
      margin-bottom: 8px;
    }

    .stat-value {
      font-size: 2.5em;
      font-weight: bold;
      margin-bottom: 5px;
    }

    .stat-detail {
      font-size: 0.85em;
      opacity: 0.8;
    }

    .performance-chart {
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      margin-bottom: 30px;
    }

    .chart-title {
      font-size: 1.3em;
      font-weight: bold;
      margin-bottom: 20px;
      color: #333;
    }

    .bar-chart {
      margin: 20px 0;
    }

    .bar-item {
      margin-bottom: 15px;
    }

    .bar-label {
      font-size: 0.9em;
      color: #666;
      margin-bottom: 5px;
    }

    .bar-container {
      background: #e0e0e0;
      height: 30px;
      border-radius: 15px;
      overflow: hidden;
      position: relative;
    }

    .bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
      transition: width 0.3s ease;
      display: flex;
      align-items: center;
      padding: 0 15px;
      color: white;
      font-weight: bold;
      font-size: 0.85em;
    }

    .alert-box {
      padding: 20px;
      border-radius: 8px;
      margin-bottom: 20px;
    }

    .alert-success {
      background: #d4edda;
      border: 1px solid #c3e6cb;
      color: #155724;
    }

    .alert-warning {
      background: #fff3cd;
      border: 1px solid #ffeeba;
      color: #856404;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 20px;
      color: #667eea;
      text-decoration: none;
      font-weight: 500;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    .refresh-info {
      text-align: center;
      color: #666;
      font-size: 0.9em;
      margin-top: 30px;
    }
  </style>
</head>
<body>
  <div class="cache-stats-container">
    <%= link_to "← Back to Dashboard", dashboard_path, class: "back-link" %>

    <div class="stats-header">
      <h1>📊 Cache Performance Statistics</h1>
      <p style="color: #666;">Real-time monitoring of system_data cache effectiveness</p>
    </div>

    <% if @cache_report[:cache_hit_rate].to_f >= 90 %>
      <div class="alert-box alert-success">
        ✅ <strong>Cache Performance: Excellent</strong> - Hit rate is <%= @cache_report[:cache_hit_rate] %> (target: &gt;90%)
      </div>
    <% elsif @cache_report[:cache_hit_rate].to_f > 0 %>
      <div class="alert-box alert-warning">
        ⚠️ <strong>Cache Performance: Below Target</strong> - Hit rate is <%= @cache_report[:cache_hit_rate] %> (target: &gt;90%). Consider investigating cache invalidation frequency.
      </div>
    <% else %>
      <div class="alert-box alert-warning">
        ℹ️ <strong>No Cache Activity</strong> - No cache requests recorded yet. Visit some pages to collect metrics.
      </div>
    <% end %>

    <div class="stats-grid">
      <div class="stat-card <%= @cache_report[:cache_hit_rate].to_f >= 90 ? 'success' : 'warning' %>">
        <div class="stat-label">Cache Hit Rate</div>
        <div class="stat-value"><%= @cache_report[:cache_hit_rate] %></div>
        <div class="stat-detail">Target: &gt;90%</div>
      </div>

      <div class="stat-card info">
        <div class="stat-label">Total Cache Hits</div>
        <div class="stat-value"><%= @cache_report[:total_hits] %></div>
        <div class="stat-detail">Served from memory</div>
      </div>

      <div class="stat-card warning">
        <div class="stat-label">Total Cache Misses</div>
        <div class="stat-value"><%= @cache_report[:total_misses] %></div>
        <div class="stat-detail">Required file I/O</div>
      </div>

      <div class="stat-card success">
        <div class="stat-label">Time Saved</div>
        <div class="stat-value"><%= (@time_saved / 1000).round(2) %>s</div>
        <div class="stat-detail"><%= @performance_gain %>% performance gain</div>
      </div>
    </div>

    <div class="performance-chart">
      <div class="chart-title">⏱️ Response Time Comparison</div>

      <div class="bar-chart">
        <div class="bar-item">
          <div class="bar-label">Cache Miss (File I/O + JSON Parse)</div>
          <div class="bar-container">
            <div class="bar-fill" style="width: 100%;">
              <%= @cache_report[:average_fetch_time_ms] %> ms
            </div>
          </div>
        </div>

        <div class="bar-item">
          <div class="bar-label">Cache Hit (Memory Read)</div>
          <div class="bar-container">
            <% width = @cache_report[:average_fetch_time_ms] > 0 ?
                       (@cache_report[:average_cache_read_time_ms] / @cache_report[:average_fetch_time_ms] * 100) : 0 %>
            <div class="bar-fill" style="width: <%= [width, 100].min %>%; background: linear-gradient(90deg, #11998e 0%, #38ef7d 100%);">
              <%= @cache_report[:average_cache_read_time_ms] %> ms
            </div>
          </div>
        </div>

        <div class="bar-item">
          <div class="bar-label">Time Saved per Cache Hit</div>
          <div class="bar-container">
            <% saved_width = @cache_report[:average_fetch_time_ms] > 0 ?
                            (@cache_report[:time_saved_per_hit_ms] / @cache_report[:average_fetch_time_ms] * 100) : 0 %>
            <div class="bar-fill" style="width: <%= [saved_width, 100].min %>%; background: linear-gradient(90deg, #f093fb 0%, #f5576c 100%);">
              <%= @cache_report[:time_saved_per_hit_ms] %> ms
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="performance-chart">
      <div class="chart-title">📈 Cumulative Performance Impact</div>

      <table style="width: 100%; border-collapse: collapse;">
        <tr style="border-bottom: 2px solid #ddd;">
          <th style="text-align: left; padding: 12px; color: #666;">Metric</th>
          <th style="text-align: right; padding: 12px; color: #666;">Value</th>
        </tr>
        <tr style="border-bottom: 1px solid #eee;">
          <td style="padding: 12px;">Total Requests</td>
          <td style="text-align: right; padding: 12px; font-weight: bold;"><%= @cache_stats[:hits] + @cache_stats[:misses] %></td>
        </tr>
        <tr style="border-bottom: 1px solid #eee;">
          <td style="padding: 12px;">Total Time Without Cache</td>
          <td style="text-align: right; padding: 12px; font-weight: bold;"><%= @total_time_without_cache.round(2) %> ms</td>
        </tr>
        <tr style="border-bottom: 1px solid #eee;">
          <td style="padding: 12px;">Total Time With Cache</td>
          <td style="text-align: right; padding: 12px; font-weight: bold; color: #11998e;"><%= @total_time_with_cache.round(2) %> ms</td>
        </tr>
        <tr style="border-bottom: 1px solid #eee;">
          <td style="padding: 12px;">Total Time Saved</td>
          <td style="text-align: right; padding: 12px; font-weight: bold; color: #f5576c;"><%= @time_saved.round(2) %> ms (<%= (@time_saved / 1000).round(3) %>s)</td>
        </tr>
        <tr>
          <td style="padding: 12px;">Performance Improvement</td>
          <td style="text-align: right; padding: 12px; font-weight: bold; color: #667eea;"><%= @performance_gain %>%</td>
        </tr>
      </table>
    </div>

    <div class="performance-chart">
      <div class="chart-title">ℹ️ Monitoring Information</div>
      <p><strong>Monitoring Started:</strong> <%= @cache_report[:last_reset] %></p>
      <p><strong>Monitoring Duration:</strong> <%= (@cache_report[:monitoring_duration] / 60).round(2) %> minutes</p>
      <p><strong>Cache Key:</strong> system_data</p>
      <p><strong>Cache Store:</strong> <%= Rails.cache.class.name %></p>
    </div>

    <div class="refresh-info">
      <p>Statistics are updated in real-time. Refresh this page to see latest metrics.</p>
      <p><%= link_to "View as JSON", dashboard_cache_stats_path(format: :json), target: "_blank" %></p>
    </div>
  </div>
</body>
</html>
