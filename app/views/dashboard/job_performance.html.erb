<div class="page-header">
  <h1>⚡ Výkon úloh na pozadí</h1>
  <p style="color: rgba(255, 255, 255, 0.8); margin-top: 0.5rem;">Sledování doby běhu generování a vizualizace soustav</p>
</div>

<% if @job_history.empty? %>
  <div class="content-section">
    <div class="card fade-in" style="border-left: 4px solid #667eea;">
      ℹ️ <strong>Žádná data o výkonu</strong> — zatím neproběhla žádná generace. Vytvořte nebo regenerujte soustavu pro sběr metrik.
    </div>
  </div>
<% else %>
  <div class="content-section">
    <% if @target_percentage >= 90 %>
      <div class="card fade-in" style="border-left: 4px solid #2ed573;">
        ✅ <strong>Výkon: výborný</strong> — <%= @target_percentage %> % úloh dokončeno do 30 s
      </div>
    <% else %>
      <div class="card fade-in" style="border-left: 4px solid #f39c12;">
        ⚠️ <strong>Výkon: pod cílem</strong> — pouze <%= @target_percentage %> % úloh do 30 s (cíl: &gt;90 %)
      </div>
    <% end %>
  </div>

  <div class="content-section">
    <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
      <div class="card stat-card">
        <div class="stat-label">V cíli (&lt;30 s)</div>
        <div class="stat-value"><%= @target_percentage %> %</div>
        <div class="stat-detail"><%= @within_target_count %>/<%= @job_history.size %> úloh</div>
      </div>

      <div class="card stat-card">
        <div class="stat-label">Průměrný čas</div>
        <div class="stat-value"><%= @avg_total_time %> s</div>
        <div class="stat-detail">Celková doba běhu</div>
      </div>

      <div class="card stat-card">
        <div class="stat-label">Nejrychlejší</div>
        <div class="stat-value"><%= @min_time %> s</div>
        <div class="stat-detail">Nejlepší běh</div>
      </div>

      <div class="card stat-card">
        <div class="stat-label">Nejpomalejší</div>
        <div class="stat-value"><%= @max_time %> s</div>
        <div class="stat-detail">Nejhorší běh</div>
      </div>
    </div>
  </div>

  <div class="content-section">
    <div class="card fade-in">
      <h3>📋 Poslední běhy úloh (<%= @job_history.size %>)</h3>
      <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
        <thead>
          <tr style="border-bottom: 2px solid rgba(255,255,255,0.2);">
            <th style="text-align: left; padding: 12px;">Čas</th>
            <th style="text-align: center; padding: 12px;">Typ</th>
            <th style="text-align: center; padding: 12px;">Planety</th>
            <th style="text-align: right; padding: 12px;">Generátor</th>
            <th style="text-align: right; padding: 12px;">Vizualizace</th>
            <th style="text-align: right; padding: 12px;">Celkem</th>
            <th style="text-align: center; padding: 12px;">Cíl</th>
          </tr>
        </thead>
        <tbody>
          <% @job_history.reverse.each do |job| %>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
              <td style="padding: 10px;"><%= job[:timestamp].strftime("%d.%m.%Y %H:%M:%S") %></td>
              <td style="text-align: center; padding: 10px;"><%= job[:job_type] %></td>
              <td style="text-align: center; padding: 10px;"><%= job[:num_planets] || "—" %></td>
              <td style="text-align: right; padding: 10px;"><%= job[:generator_duration] ? "#{job[:generator_duration]} s" : "—" %></td>
              <td style="text-align: right; padding: 10px;"><%= job[:visualizer_duration] ? "#{job[:visualizer_duration]} s" : "—" %></td>
              <td style="text-align: right; padding: 10px; font-weight: bold;"><%= job[:total_duration] %> s</td>
              <td style="text-align: center; padding: 10px;">
                <span style="color: <%= job[:within_target] ? '#2ed573' : '#f5576c' %>; font-weight: bold;">
                  <%= job[:within_target] ? '✓' : '✗' %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="content-section">
    <div class="card fade-in">
      <h3>📊 Rozklad výkonu</h3>
      <p><strong>Průměr generátoru:</strong> <%= @avg_generator_time %> s (generování dat)</p>
      <p><strong>Průměr vizualizace:</strong> <%= @avg_visualizer_time %> s (tvorba SVG)</p>
      <p><strong>Počet záznamů:</strong> <%= @job_history.size %> (uchovává se posledních 20)</p>
    </div>
  </div>
<% end %>

<nav class="actions" role="navigation">
  <%= link_to "← Zpět na přehled", dashboard_path, class: "btn btn-secondary" %>
  <%= link_to "Zobrazit jako JSON", dashboard_job_performance_path(format: :json), class: "btn btn-secondary", target: "_blank" %>
</nav>

<style>
  .stat-card .stat-label {
    font-size: 0.9em;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }

  .stat-card .stat-value {
    font-size: 2.2em;
    font-weight: bold;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }

  .stat-card .stat-detail {
    font-size: 0.85em;
    opacity: 0.7;
  }
</style>
