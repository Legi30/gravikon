<!DOCTYPE html>
<html>
<head>
  <title>Job Performance - Gravikon</title>
  <%= stylesheet_link_tag "gravikon" %>
  <style>
    .job-stats-container { max-width: 1200px; margin: 40px auto; padding: 20px; }
    .stats-header { text-align: center; margin-bottom: 40px; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .stat-card { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    .stat-card.success { background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); }
    .stat-card.warning { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
    .stat-label { font-size: 0.9em; opacity: 0.9; margin-bottom: 8px; }
    .stat-value { font-size: 2.5em; font-weight: bold; }
    .history-table { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 30px; }
    .back-link { display: inline-block; margin-bottom: 20px; color: #667eea; text-decoration: none; font-weight: 500; }
    .alert-box { padding: 20px; border-radius: 8px; margin-bottom: 20px; }
    .alert-success { background: #d4edda; border: 1px solid #c3e6cb; color: #155724; }
    .alert-warning { background: #fff3cd; border: 1px solid #ffeeba; color: #856404; }
  </style>
</head>
<body>
  <div class="job-stats-container">
    <%= link_to "← Back to Dashboard", dashboard_path, class: "back-link" %>

    <div class="stats-header">
      <h1>⚡ Background Job Performance</h1>
      <p style="color: #666;">GenerateSystemJob execution time monitoring</p>
    </div>

    <% if @job_history.empty? %>
      <div class="alert-box alert-warning">
        ℹ️ <strong>No Performance Data</strong> - No system regenerations recorded yet. Regenerate the system to collect metrics.
      </div>
    <% else %>
      <% if @target_percentage >= 90 %>
        <div class="alert-box alert-success">
          ✅ <strong>Performance: Excellent</strong> - <%= @target_percentage %>% of jobs complete within 30s target
        </div>
      <% else %>
        <div class="alert-box alert-warning">
          ⚠️ <strong>Performance: Below Target</strong> - Only <%= @target_percentage %>% of jobs within 30s (target: >90%)
        </div>
      <% end %>

      <div class="stats-grid">
        <div class="stat-card <%= @target_percentage >= 90 ? 'success' : 'warning' %>">
          <div class="stat-label">Within Target</div>
          <div class="stat-value"><%= @target_percentage %>%</div>
          <div class="stat-detail"><%= @within_target_count %>/<%= @job_history.size %> jobs &lt;30s</div>
        </div>

        <div class="stat-card">
          <div class="stat-label">Average Time</div>
          <div class="stat-value"><%= @avg_total_time %>s</div>
          <div class="stat-detail">Overall execution</div>
        </div>

        <div class="stat-card success">
          <div class="stat-label">Fastest</div>
          <div class="stat-value"><%= @min_time %>s</div>
          <div class="stat-detail">Best performance</div>
        </div>

        <div class="stat-card warning">
          <div class="stat-label">Slowest</div>
          <div class="stat-value"><%= @max_time %>s</div>
          <div class="stat-detail">Worst performance</div>
        </div>
      </div>

      <div class="history-table">
        <h3>📋 Recent Job Executions (Last <%= @job_history.size %>)</h3>
        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
          <thead>
            <tr style="border-bottom: 2px solid #ddd;">
              <th style="text-align: left; padding: 12px;">Timestamp</th>
              <th style="text-align: center; padding: 12px;">Planets</th>
              <th style="text-align: center; padding: 12px;">Moons</th>
              <th style="text-align: right; padding: 12px;">Generator</th>
              <th style="text-align: right; padding: 12px;">Visualizer</th>
              <th style="text-align: right; padding: 12px;">Total</th>
              <th style="text-align: center; padding: 12px;">Target</th>
            </tr>
          </thead>
          <tbody>
            <% @job_history.reverse.each do |job| %>
              <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px;"><%= job[:timestamp].strftime("%Y-%m-%d %H:%M:%S") %></td>
                <td style="text-align: center; padding: 10px;"><%= job[:num_planets] %></td>
                <td style="text-align: center; padding: 10px;"><%= job[:max_moons] %></td>
                <td style="text-align: right; padding: 10px;"><%= job[:generator_duration] %>s</td>
                <td style="text-align: right; padding: 10px;"><%= job[:visualizer_duration] %>s</td>
                <td style="text-align: right; padding: 10px; font-weight: bold;"><%= job[:total_duration] %>s</td>
                <td style="text-align: center; padding: 10px;">
                  <span style="color: <%= job[:within_target] ? '#11998e' : '#f5576c' %>; font-weight: bold;">
                    <%= job[:within_target] ? '✓' : '✗' %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="history-table">
        <h3>📊 Performance Breakdown</h3>
        <p><strong>Generator Average:</strong> <%= @avg_generator_time %>s (data generation)</p>
        <p><strong>Visualizer Average:</strong> <%= @avg_visualizer_time %>s (SVG creation)</p>
        <p><strong>Total Records:</strong> <%= @job_history.size %> (last 20 executions kept)</p>
        <p style="margin-top: 20px;"><%= link_to "View as JSON", dashboard_job_performance_path(format: :json), target: "_blank" %></p>
      </div>
    <% end %>
  </div>
</body>
</html>
