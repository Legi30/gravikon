<% content_for :body_class, "dashboard-page" %>

<div class="page-header">
  <h1>Přehled soustav</h1>
  <p class="dashboard-lead">Seznamte se se soustavami galaxie: kdo v nich žije, jak rychle tam plyne čas a jak spolu komunikují.</p>
</div>

<% if @profiles.empty? %>
  <div class="content-section">
    <div class="card">
      <p class="empty-state">V galaxii zatím nejsou žádné soustavy. <%= link_to "Vytvořit první soustavu", new_galaxy_system_path %></p>
    </div>
  </div>
<% else %>
  <%# One profile at a time: every panel is rendered, the switcher only
      toggles visibility (no reload) and keeps the choice in the URL hash %>
  <div class="system-profiles fade-in" id="system-profiles">
    <div class="system-switcher" role="tablist" aria-label="Soustavy">
      <% @profiles.each_with_index do |profile, index| %>
        <% system = profile[:system] %>
        <button type="button" role="tab" class="system-pill"
                id="tab-system-<%= system.id %>"
                aria-controls="profile-system-<%= system.id %>"
                aria-selected="<%= index.zero? %>"
                tabindex="<%= index.zero? ? 0 : -1 %>"
                data-hash="soustava-<%= system.id %>"
                style="--system-color: <%= system_color(system.id) %>;">
          <span class="system-dot" aria-hidden="true"></span><%= system.name %>
        </button>
      <% end %>
    </div>

    <% @profiles.each_with_index do |profile, index| %>
      <% system = profile[:system] %>
      <section class="system-profile" id="profile-system-<%= system.id %>" role="tabpanel"
               aria-labelledby="tab-system-<%= system.id %>"
               style="--system-color: <%= system_color(system.id) %>;"
               <%= "hidden" unless index.zero? %>>
        <header class="profile-head">
          <h2 class="profile-name"><span class="system-dot" aria-hidden="true"></span><%= system.name %></h2>
          <p class="profile-intro"><%= system_intro(profile) %></p>
          <dl class="profile-facts">
            <div>
              <dt>Od černé díry</dt>
              <dd><%= format_distance_km(profile[:distance]) %></dd>
            </div>
            <div>
              <dt>Za vaši hodinu</dt>
              <dd><%= format_minutes(profile[:rate] * 60) %> min</dd>
            </div>
            <div>
              <dt>Obyvatelé</dt>
              <dd><%= cs_count(profile[:planets].size, "planeta", "planety", "planet") %>, <%= cs_count(profile[:moon_count], "měsíc", "měsíce", "měsíců") %></dd>
            </div>
          </dl>
        </header>

        <div class="profile-body">
          <div class="profile-block">
            <h3>Kdo tu žije</h3>
            <p class="profile-story"><%= system_story(profile) %></p>
            <p class="profile-hint">Kolik minut uběhne na každém tělese, zatímco vám uběhne hodina:</p>
            <ul class="inhabitant-list">
              <% profile[:stars].each do |star| %>
                <li class="inhabitant inhabitant--star">
                  <span class="inhabitant-name"><%= star[:name] %> <small><%= profile[:stars].size >= 2 ? "dvojhvězda" : "hvězda" %></small></span>
                  <span class="inhabitant-track"><span class="inhabitant-bar" style="width: <%= (star[:dilation] * 100).clamp(0, 100).round(1) %>%;"></span></span>
                  <span class="inhabitant-value"><%= format_minutes(star[:dilation] * 60) %> min</span>
                </li>
              <% end %>
              <% profile[:planets].each do |planet| %>
                <li class="inhabitant inhabitant--planet">
                  <span class="inhabitant-name"><%= planet[:name] %> <small>planeta</small></span>
                  <span class="inhabitant-track"><span class="inhabitant-bar" style="width: <%= (planet[:dilation] * 100).clamp(0, 100).round(1) %>%;"></span></span>
                  <span class="inhabitant-value"><%= format_minutes(planet[:dilation] * 60) %> min</span>
                </li>
                <% planet[:moons].each do |moon| %>
                  <li class="inhabitant inhabitant--moon">
                    <span class="inhabitant-name"><%= moon[:name] %> <small>měsíc</small></span>
                    <span class="inhabitant-track"><span class="inhabitant-bar" style="width: <%= (moon[:dilation] * 100).clamp(0, 100).round(1) %>%;"></span></span>
                    <span class="inhabitant-value"><%= format_minutes(moon[:dilation] * 60) %> min</span>
                  </li>
                <% end %>
              <% end %>
            </ul>
          </div>

          <div class="profile-block">
            <h3>Vztahy s ostatními</h3>
            <% if profile[:relations].empty? %>
              <p class="profile-hint">V galaxii zatím není žádná jiná soustava.</p>
            <% else %>
              <p class="profile-hint">Jak dlouho k nim letí signál a kolik u nich uběhne, zatímco tady uplyne hodina.</p>
              <ul class="relation-list">
                <% profile[:relations].each do |relation| %>
                  <li class="relation" style="--other-color: <%= system_color(relation[:system].id) %>;">
                    <span class="relation-name"><span class="system-dot system-dot--other" aria-hidden="true"></span><%= relation[:system].name %></span>
                    <span class="relation-facts">
                      <span>signál <strong><%= format_delay_display(relation[:signal_delay]) %></strong></span>
                      <% if relation[:minutes_there_per_hour_here] %>
                        <span>hodina tady = <strong><%= format_minutes(relation[:minutes_there_per_hour_here]) %> min</strong> tam</span>
                      <% end %>
                      <% if relation[:shared_meetings].positive? %>
                        <span><%= cs_count(relation[:shared_meetings], "společná schůzka", "společné schůzky", "společných schůzek") %></span>
                      <% end %>
                    </span>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>
        </div>

        <% if profile[:meetings].any? %>
          <div class="profile-meetings">
            <h3>Schůzky</h3>
            <ul class="profile-meeting-list">
              <% profile[:meetings].each do |meeting| %>
                <li>
                  <span class="pm-time"><%= "#{meeting.start_time}–#{meeting.end_time}" %></span>
                  <span class="pm-topic">
                    <%= meeting.topic.presence || "(bez tématu)" %>
                    <% if meeting.is_inter_system %><span class="pm-badge">mezi soustavami</span><% end %>
                  </span>
                  <span class="pm-stats">prožito <%= meeting.formatted_duration %> · signál <%= format_delay_display(meeting.avg_delay) %></span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <footer class="profile-foot">
          <%= link_to "Prohlédnout soustavu", galaxy_system_path(system), class: "btn btn-secondary btn-sm" %>
        </footer>
      </section>
    <% end %>
  </div>
<% end %>

<%# Time across the galaxy: every body's dilation vs. its system's distance
    from the black hole (data from DashboardHelper#galaxy_time_chart_data,
    passed as an HTML-escaped data attribute and drawn below with Chart.js) %>
<div class="content-section">
  <div class="card fade-in galaxy-time-card" style="animation-delay: 0.2s;">
    <h3>Čas napříč galaxií</h3>
    <p class="chart-description">
      Kolik minut uběhne na každém tělese, zatímco vzdálenému pozorovateli uběhne hodina.
      Čára je vliv samotné černé díry. Tečky jsou tělesa: pod čáru je stahuje ještě jejich vlastní gravitace.
    </p>
    <% if @galaxy_time_chart[:systems].any? { |system| system[:bodies].any? } %>
      <div class="galaxy-time-chart">
        <canvas id="galaxyTimeChart" data-chart="<%= @galaxy_time_chart.to_json %>" role="img" aria-label="Bodový graf: rychlost plynutí času na tělesech jednotlivých soustav podle vzdálenosti od černé díry."></canvas>
      </div>

    <% else %>
      <p class="empty-state">V galaxii zatím nejsou žádná tělesa.</p>
    <% end %>
  </div>
</div>

<!-- Chart.js Library (vendored locally) -->
<script src="<%= asset_path('vendor/chart.umd.min.js') %>"></script>

<!-- Time across the galaxy chart -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const canvas = document.getElementById('galaxyTimeChart');
  if (!canvas || !window.Chart) return;

  const data = JSON.parse(canvas.getAttribute('data-chart'));

  // Each system arrives with its shared colour (ApplicationHelper#system_color,
  // a validated categorical palette in fixed id order); systems past the
  // palette are flagged `other` and fold into one neutral "Ostatní" series.
  const SURFACE = '#1a1e3a';
  const TEXT = 'rgba(224, 224, 224, 0.85)';
  const MUTED = 'rgba(224, 224, 224, 0.55)';
  const RADIUS = { star: 6, planet: 4.5, moon: 3 };
  // Canvas units → km for display (1 unit = 1 000 km, PhysicsConstants::UNIT_METERS)
  const KM = (units) => Math.round(units * 1000).toLocaleString('cs-CZ');

  const toPoints = (system) => system.bodies.map(body => ({
    x: system.distance,
    y: body.dilation * 60,
    name: body.name,
    system: system.name,
    type: body.type
  }));

  const scatter = (label, color, points, systemLabel) => ({
    type: 'scatter',
    label: label,
    data: points,
    systemLabel: systemLabel,
    backgroundColor: color,
    borderColor: SURFACE,
    borderWidth: 1.5,
    pointRadius: points.map(p => RADIUS[p.type] || 4),
    pointHoverRadius: points.map(p => (RADIUS[p.type] || 4) + 2),
    pointHitRadius: 8
  });

  const named = data.systems.filter(system => !system.other);
  const rest = data.systems.filter(system => system.other);
  const datasets = named.map(system => scatter(system.name, system.color, toPoints(system), true));
  if (rest.length > 0) {
    datasets.push(scatter('Ostatní', rest[0].color, rest.flatMap(toPoints), false));
  }

  datasets.push({
    type: 'line',
    label: 'Jen černá díra',
    data: data.curve.map(p => ({ x: p.x, y: p.y * 60 })),
    borderColor: 'rgba(224, 224, 224, 0.45)',
    borderWidth: 2,
    borderDash: [5, 4],
    pointRadius: 0,
    pointHitRadius: 4,
    tension: 0.3,
    order: 10
  });

  // Direct labels (system name above its topmost body) while there are few
  // enough systems to label without collisions; text uses ink, not series colour
  const directLabels = {
    id: 'directLabels',
    afterDatasetsDraw(chart) {
      // Narrow charts squeeze neighbouring labels together; the legend covers it
      if (named.length > 4 || chart.width < 600) return;
      const ctx = chart.ctx;
      ctx.save();
      ctx.font = '600 12px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillStyle = TEXT;
      chart.data.datasets.forEach((dataset, i) => {
        const meta = chart.getDatasetMeta(i);
        if (!dataset.systemLabel || meta.hidden) return;
        const top = meta.data.reduce((best, el) => (!best || el.y < best.y ? el : best), null);
        if (top) ctx.fillText(dataset.label, top.x, top.y - 12);
      });
      ctx.restore();
    }
  };

  new Chart(canvas, {
    data: { datasets: datasets },
    plugins: [directLabels],
    options: {
      responsive: true,
      maintainAspectRatio: false,
      layout: { padding: { top: 18 } },
      scales: {
        x: {
          type: 'linear',
          // Systems can't sit closer than 50 units; the curve ends just past the farthest one
          min: 50,
          max: data.curve.length ? data.curve[data.curve.length - 1].x : undefined,
          title: { display: true, text: 'Vzdálenost od černé díry (km)', color: MUTED },
          ticks: { color: MUTED, callback: (value) => KM(value) },
          grid: { color: 'rgba(255, 255, 255, 0.05)' }
        },
        y: {
          suggestedMax: 60,
          title: { display: true, text: 'Minut za hodinu pozorovatele', color: MUTED },
          ticks: { color: MUTED },
          grid: { color: 'rgba(255, 255, 255, 0.06)' }
        }
      },
      plugins: {
        legend: {
          position: 'bottom',
          labels: { color: TEXT, usePointStyle: true, font: { family: 'Inter, sans-serif', size: 12 } }
        },
        tooltip: {
          backgroundColor: 'rgba(26, 30, 58, 0.95)',
          titleColor: '#ffd700',
          bodyColor: '#e0e0e0',
          borderColor: 'rgba(255, 215, 0, 0.5)',
          borderWidth: 1,
          callbacks: {
            title: (items) => {
              const raw = items[0].raw;
              return raw.name ? `${raw.name} (${raw.system})` : `Jen černá díra, ${KM(raw.x)} km`;
            },
            label: (item) => `${item.parsed.y.toFixed(1)} min za hodinu pozorovatele`
          }
        }
      }
    }
  });
});
</script>
<!-- System switcher: shows one profile, keeps the choice in the URL hash -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const root = document.getElementById('system-profiles');
  if (!root) return;

  const tabs = Array.from(root.querySelectorAll('.system-pill'));

  function select(tab, updateHash) {
    tabs.forEach(function(other) {
      const active = other === tab;
      other.setAttribute('aria-selected', String(active));
      other.tabIndex = active ? 0 : -1;
      document.getElementById(other.getAttribute('aria-controls')).hidden = !active;
    });
    if (updateHash) history.replaceState(null, '', '#' + tab.dataset.hash);
  }

  tabs.forEach(function(tab, index) {
    tab.addEventListener('click', function() { select(tab, true); });
    tab.addEventListener('keydown', function(e) {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(index + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      select(next, true);
      next.focus();
    });
  });

  const fromHash = tabs.find(function(tab) { return '#' + tab.dataset.hash === location.hash; });
  if (fromHash) select(fromHash, false);
});
</script>

<style>
.dashboard-lead {
  color: rgba(224, 224, 224, 0.75);
  margin-top: var(--spacing-sm);
}

/* === System switcher (pills) =============================================
   Same idea as the system colours everywhere: each pill carries its
   system's colour; the active one is tinted with it. */
.system-switcher {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-bottom: var(--spacing-md);
}

.system-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1.1rem;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.03);
  color: rgba(224, 224, 224, 0.8);
  font-family: 'Oxanium', sans-serif;
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
  transition: border-color var(--transition-fast), background var(--transition-fast), color var(--transition-fast);
}

.system-pill:hover {
  border-color: var(--system-color);
  color: #fff;
}

.system-pill[aria-selected="true"] {
  border-color: var(--system-color);
  background: color-mix(in srgb, var(--system-color) 22%, transparent);
  color: #fff;
}

.system-dot {
  display: inline-block;
  width: 0.65rem;
  height: 0.65rem;
  border-radius: 50%;
  background: var(--system-color);
  box-shadow: 0 0 8px var(--system-color);
  flex: none;
}

.system-dot--other {
  background: var(--other-color);
  box-shadow: 0 0 6px var(--other-color);
}

/* === Profile panel ======================================================== */
.system-profile {
  position: relative;
  padding: var(--spacing-lg);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-lg);
  background:
    radial-gradient(ellipse 60% 120% at 0% 0%, color-mix(in srgb, var(--system-color) 14%, transparent), transparent 70%),
    linear-gradient(135deg, rgba(26, 30, 58, 0.85) 0%, rgba(15, 18, 35, 0.85) 100%);
  margin-bottom: var(--spacing-xl);
  animation: profile-in 0.35s ease;
}

@keyframes profile-in {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: none; }
}

.profile-name {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin: 0;
  font-size: 2rem;
  color: #fff;
}

.profile-name .system-dot {
  width: 0.9rem;
  height: 0.9rem;
}

.profile-intro {
  max-width: 760px;
  margin: 0.75rem 0 0;
  color: rgba(224, 224, 224, 0.8);
  line-height: 1.65;
}

.profile-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 2.5rem;
  margin: 1.25rem 0 0;
}

.profile-facts dt {
  font-size: 0.75rem;
  color: rgba(224, 224, 224, 0.55);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.profile-facts dd {
  margin: 0.15rem 0 0;
  font-family: 'Oxanium', sans-serif;
  font-weight: 700;
  font-size: 1.25rem;
  color: var(--accent);
  white-space: nowrap;
}

.profile-body {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: var(--spacing-lg);
  margin-top: var(--spacing-lg);
  padding-top: var(--spacing-lg);
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.system-profile h3 {
  margin: 0;
  font-size: 1.05rem;
  color: var(--accent);
}

.profile-story {
  margin: 0 0 var(--spacing-sm);
  font-size: 0.95rem;
  line-height: 1.6;
  font-style: italic;
  color: rgba(224, 224, 224, 0.85);
}

.profile-hint {
  margin: 0.25rem 0 0.9rem;
  font-size: 0.85rem;
  color: rgba(224, 224, 224, 0.55);
}

/* Inhabitants: planets with their moons indented beneath them; the bar is
   the share of your hour that passes on that body (full = 60 min) */
.inhabitant-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.inhabitant {
  display: grid;
  grid-template-columns: minmax(7.5rem, 11rem) 1fr 4.5rem;
  align-items: center;
  gap: 0.75rem;
  padding: 0.3rem 0;
}

.inhabitant-name {
  color: #fff;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.inhabitant-name small {
  margin-left: 0.3rem;
  font-weight: 400;
  font-size: 0.75rem;
  color: rgba(224, 224, 224, 0.45);
}

.inhabitant--planet {
  margin-top: 0.35rem;
}

.inhabitant--moon .inhabitant-name {
  padding-left: 1.1rem;
  font-weight: 400;
  color: rgba(224, 224, 224, 0.75);
}

.inhabitant-track {
  height: 6px;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.08);
}

.inhabitant-bar {
  display: block;
  height: 100%;
  border-radius: 3px;
  background: var(--system-color);
}

.inhabitant--moon .inhabitant-bar {
  opacity: 0.65;
}

.inhabitant-value {
  text-align: right;
  font-variant-numeric: tabular-nums;
  font-size: 0.9rem;
  color: rgba(224, 224, 224, 0.85);
  white-space: nowrap;
}

/* Relations */
.relation-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.relation {
  padding: 0.75rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.relation:last-child {
  border-bottom: none;
}

.relation-name {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: 'Oxanium', sans-serif;
  font-weight: 700;
  color: #fff;
}

.relation-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 0.2rem 1rem;
  margin-top: 0.3rem;
  padding-left: 1.15rem;
  font-size: 0.88rem;
  color: rgba(224, 224, 224, 0.6);
}

.relation-facts strong {
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

/* Meetings: a small list, the page is about the systems */
.profile-meetings {
  margin-top: var(--spacing-lg);
  padding-top: var(--spacing-lg);
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.profile-meeting-list {
  list-style: none;
  margin: 0.75rem 0 0;
  padding: 0;
}

.profile-meeting-list li {
  display: grid;
  grid-template-columns: 7rem 1fr auto;
  gap: 1rem;
  align-items: baseline;
  padding: 0.45rem 0;
  font-size: 0.92rem;
}

.pm-time {
  font-variant-numeric: tabular-nums;
  color: rgba(224, 224, 224, 0.6);
  white-space: nowrap;
}

.pm-topic {
  color: #fff;
}

.pm-badge {
  margin-left: 0.4rem;
  padding: 0.05rem 0.45rem;
  border-radius: 4px;
  background: rgba(255, 215, 0, 0.12);
  color: var(--accent);
  font-size: 0.72rem;
  white-space: nowrap;
}

.pm-stats {
  color: rgba(224, 224, 224, 0.55);
  white-space: nowrap;
}

.profile-foot {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  margin-top: var(--spacing-lg);
}

/* === Galaxy chart card ==================================================== */
.chart-description {
  color: rgba(224, 224, 224, 0.7);
  margin-bottom: var(--spacing-md);
  max-width: 760px;
  font-size: 0.95rem;
}

.empty-state {
  text-align: center;
  padding: var(--spacing-xl);
  color: rgba(224, 224, 224, 0.5);
  font-style: italic;
}

.galaxy-time-chart {
  position: relative;
  height: 400px;
}

@media (max-width: 860px) {
  .profile-body {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .system-profile {
    padding: var(--spacing-md);
  }

  .profile-name {
    font-size: 1.5rem;
  }

  .profile-meeting-list li {
    grid-template-columns: 1fr;
    gap: 0.1rem;
  }

  .galaxy-time-chart {
    height: 320px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .system-profile {
    animation: none;
  }
}
</style>
