<% content_for :body_class, "system-form-page" %>

<div class="system-form-layout">
  <div class="system-form-main">
    <header class="page-header">
      <p class="system-detail-back"><%= link_to "Všechny soustavy", galaxy_systems_path %></p>
      <h1>Nová soustava</h1>
      <p>
        Vyberte místo v galaxii a Gravikon tam vygeneruje hvězdu, planety i měsíce.
        Čím blíž černé díře soustavu postavíte, tím pomaleji v ní poběží čas.
      </p>
      <% if @suggested_position %>
        <p class="suggestion-note">
          Volné místo jsme už našli a předvyplnili: X <%= @suggested_position[:x].round(1) %>, Y <%= @suggested_position[:y].round(1) %>.
        </p>
      <% end %>
    </header>

    <%= render partial: 'system_form',
               locals: {
                 system: @system,
                 url: galaxy_systems_path,
                 method: :post,
                 form_label: "Formulář pro vytvoření nové planetární soustavy",
                 submit_text: "Vytvořit soustavu",
                 cancel_path: galaxy_systems_path,
                 suggested_position: @suggested_position
               } %>
  </div>

  <aside class="system-form-map" aria-labelledby="picker-heading">
    <h2 id="picker-heading">Místo v galaxii</h2>
    <p class="profile-hint">Klikněte do mapy a souřadnice se vyplní samy.</p>

    <div id="position-preview">
      <% if @galaxy_svg.present? %>
        <%= raw @galaxy_svg %>
        <%# Keep-out zones drawn over the embedded map (same 800×800 viewBox).
            galaxy.js leaves the picker's systems at their STORED positions,
            which is what these zones and the validation use. %>
        <svg class="position-zones" viewBox="0 0 800 800" aria-hidden="true">
          <circle cx="400" cy="400" r="50" class="zone-black-hole"/>
          <% @systems.each do |other_system| %>
            <circle cx="<%= other_system.x %>" cy="<%= other_system.y %>" r="40" class="zone-system"/>
          <% end %>
        </svg>
      <% else %>
        <svg viewBox="0 0 800 800" style="width: 100%; height: 100%;">
          <!-- Black hole at center -->
          <circle cx="400" cy="400" r="30" fill="#8b5cf6" opacity="0.3"/>
          <circle cx="400" cy="400" r="50" fill="none" stroke="#e74c3c" stroke-width="2" stroke-dasharray="5,5" opacity="0.5"/>

          <!-- Existing systems -->
          <% if @systems.present? %>
            <% @systems.each do |other_system| %>
              <circle cx="<%= other_system.x %>" cy="<%= other_system.y %>" r="10" fill="rgba(255,255,255,0.3)" stroke="rgba(255,255,255,0.5)" stroke-width="1"/>
              <text x="<%= other_system.x %>" y="<%= other_system.y - 15 %>" text-anchor="middle" fill="rgba(255,255,255,0.5)" font-size="9"><%= other_system.name %></text>
            <% end %>
          <% end %>
        </svg>
      <% end %>
    </div>

    <ul class="position-legend">
      <li><span class="legend-ring legend-ring-black-hole" aria-hidden="true"></span>k černé díře aspoň <%= format_distance_km(50) %></li>
      <li><span class="legend-ring legend-ring-system" aria-hidden="true"></span>k jiné soustavě aspoň <%= format_distance_km(40) %></li>
      <li><span class="legend-dot" aria-hidden="true"></span>vaše místo</li>
    </ul>
  </aside>
</div>

<style>
  .suggestion-note {
    font-size: 0.95rem;
    color: #5eead4;
  }
</style>
