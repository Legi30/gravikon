<div class="page-header">
  <h1>Mapa galaxie</h1>
</div>

<%# === Galaxy map hero — the map is the landing page === %>
<% if @galaxy_svg.present? %>
  <div class="svg-container fade-in galaxy-hero" role="img" aria-label="Interaktivní mapa galaxie s planetárními soustavami">
    <%= raw @galaxy_svg %>
  </div>
  <p class="galaxy-hero-hint">Klikněte na soustavu pro zobrazení detailů nebo najeďte myší pro rychlý náhled. Soustavy obíhají kolem černé díry v reálném čase.</p>

  <% if @systems.present? %>
    <div class="galaxy-stats-strip fade-in" role="list" aria-label="Statistiky galaxie">
      <div class="galaxy-stat" role="listitem">
        <span class="galaxy-stat-value"><%= @systems.count %></span>
        <span class="galaxy-stat-label"><%= @systems.count == 1 ? "soustava" : (@systems.count < 5 ? "soustavy" : "soustav") %></span>
      </div>
      <div class="galaxy-stat" role="listitem">
        <span class="galaxy-stat-value"><%= @systems.sum { |s| s.load_system_data&.dig('bodies')&.count || 0 } %></span>
        <span class="galaxy-stat-label">těles</span>
      </div>
      <div class="galaxy-stat" role="listitem">
        <span class="galaxy-stat-value">🕳</span>
        <span class="galaxy-stat-label"><%= @galaxy_data['black_hole']['name'] %></span>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="content-section">
    <div class="card fade-in">
      <p style="color: rgba(255, 255, 255, 0.7);">Mapa galaxie se nepodařila načíst. Zkuste obnovit stránku.</p>
    </div>
  </div>
<% end %>

<%# === System list === %>
<div class="content-section">
  <div class="card fade-in">
    <h3>Seznam soustav</h3>

    <% if @systems.empty? %>
      <div class="empty-state" role="status">
        <p>V galaxii zatím nebyly vytvořeny žádné planetární soustavy.</p>
        <p>
          <%= link_to "Vytvořit první soustavu", new_galaxy_system_path, class: "btn btn-primary", "aria-label" => "Vytvořit první planetární soustavu" %>
        </p>
      </div>
    <% else %>
      <div class="systems-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 1.5rem;">
        <% @systems.each do |system| %>
          <% system_data = system.load_system_data %>
          <% body_count = system_data&.dig('bodies')&.count || 0 %>
          <div class="system-card">
            <h4 style="margin: 0 0 0.75rem 0; color: var(--accent); font-size: 1.1rem;">
              <%= link_to system.name, galaxy_system_path(system), style: "color: inherit; text-decoration: none;" %>
            </h4>
            <div class="system-info" style="font-size: 0.9rem; line-height: 1.6; color: rgba(255, 255, 255, 0.8);">
              <div><strong>Pozice:</strong> (<%= system.x.round(1) %>, <%= system.y.round(1) %>)</div>
              <div><strong>Počet těles:</strong> <%= body_count %></div>
              <% if system_data %>
                <% star = system_data['bodies']&.find { |b| b['type'] == 'star' } %>
                <% if star %>
                  <div><strong>Hvězda:</strong> <%= star['name'] %></div>
                <% end %>
              <% end %>
            </div>
            <div class="system-actions" style="margin-top: 1rem; display: flex; gap: 0.5rem;">
              <%= link_to "Zobrazit", galaxy_system_path(system), class: "btn btn-primary btn-sm" %>
              <%= link_to "Upravit", edit_galaxy_system_path(system), class: "btn btn-secondary btn-sm" %>
            </div>
          </div>
        <% end %>

        <%# Add-system card %>
        <%= link_to new_galaxy_system_path, class: "system-card add-system-card", "aria-label" => "Přidat novou planetární soustavu do galaxie" do %>
          <span class="add-system-plus" aria-hidden="true">+</span>
          <span class="add-system-text">Přidat soustavu</span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Tooltip for system information (managed by galaxy.js) -->
<div id="tooltip" role="tooltip" aria-live="polite"></div>

<style>
  .btn-sm {
    font-size: 0.85rem;
    padding: 0.4rem 0.8rem;
  }

  .galaxy-hero {
    margin-top: 0.5rem;
  }

  .galaxy-hero-hint {
    text-align: center;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.9rem;
    margin: 0.75rem auto 0;
    max-width: 640px;
  }

  .galaxy-stats-strip {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    margin: 1.25rem auto 0;
    padding: 0.9rem 1.5rem;
    max-width: 640px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
  }

  .galaxy-stat {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .galaxy-stat-value {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.3rem;
    color: var(--accent);
    font-weight: 700;
  }

  .galaxy-stat-label {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
  }

  .system-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 1.25rem;
    transition: all 0.3s ease;
  }

  .system-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .add-system-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 150px;
    border: 2px dashed rgba(255, 215, 0, 0.35);
    background: rgba(255, 215, 0, 0.03);
    text-decoration: none;
    color: rgba(255, 215, 0, 0.8);
  }

  .add-system-card:hover {
    border-color: var(--accent);
    background: rgba(255, 215, 0, 0.08);
    color: var(--accent);
  }

  .add-system-plus {
    font-size: 2.5rem;
    line-height: 1;
    font-weight: 300;
  }

  .add-system-text {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
</style>
