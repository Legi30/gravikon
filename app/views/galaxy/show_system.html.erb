<div class="page-header system-page-header">
  <div>
    <nav aria-label="Breadcrumb" style="margin-bottom: 1rem;">
      <ol style="list-style: none; padding: 0; display: flex; gap: 0.5rem; font-size: 0.9rem; color: rgba(255, 255, 255, 0.7);">
        <li><%= link_to "Mapa galaxie", galaxy_index_path, style: "color: var(--accent); text-decoration: none;" %></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page"><%= @system.name %></li>
      </ol>
    </nav>
    <h1 class="system-title" style="--system-color: <%= system_color(@system.id) %>; --system-tint: <%= system_tint(@system.id) %>;"><span class="system-title-dot" aria-hidden="true"></span><%= @system.name %></h1>
  </div>

  <nav class="system-header-actions" role="navigation" aria-label="Akce se soustavou">
    <% unless @system.core? %>
      <%= link_to "Upravit soustavu", edit_galaxy_system_path(@system), class: "btn btn-primary", "aria-label" => "Upravit parametry soustavy" %>
      <%= button_to "Smazat", galaxy_system_path(@system), method: :delete, form: { onsubmit: "return confirm('Opravdu chcete smazat soustavu #{j @system.name}? Tato akce je nevratná.');", style: "display: contents;" }, class: "btn btn-danger", "aria-label" => "Smazat soustavu" %>
    <% end %>
    <%= link_to "Zpět na galaxii", galaxy_index_path, class: "btn btn-secondary", "aria-label" => "Návrat na mapu galaxie" %>
  </nav>
</div>

<style>
  .system-page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .system-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--system-tint);
    text-shadow: none;
  }

  .system-title-dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    flex: none;
    background: var(--system-tint);
    box-shadow: 0 0 14px var(--system-color);
  }

  .system-svg .celestial-body[data-type="planet"] {
    fill: var(--tone-0);
  }

  .system-svg .celestial-body[data-type="planet"][data-tone="1"] {
    fill: var(--tone-1);
  }

  .system-svg .celestial-body[data-type="planet"][data-tone="2"] {
    fill: var(--tone-2);
  }

  .system-svg .celestial-body[data-type="moon"] {
    fill: var(--tone-moon);
  }

  .system-svg .orbit-path {
    stroke: var(--system-color);
    stroke-opacity: 0.55;
  }

  .system-header-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  /* Uniform control height regardless of <a> vs <button> rendering */
  .system-header-actions .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    padding-top: 0;
    padding-bottom: 0;
    border: none;
    font-size: 0.9rem;
  }
</style>

<div class="content-section">
  <div class="card fade-in">
    <h3>Metadata soustavy</h3>
    <div class="system-metadata" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-top: 1rem;">
      <div class="metadata-item">
        <strong style="color: var(--accent); display: block; margin-bottom: 0.5rem;">Název soustavy</strong>
        <span><%= @system.name %></span>
      </div>

      <div class="metadata-item">
        <strong style="color: var(--accent); display: block; margin-bottom: 0.5rem;">Pozice v galaxii</strong>
        <span>X: <%= @system.x.round(2) %>, Y: <%= @system.y.round(2) %></span>
      </div>

      <div class="metadata-item">
        <strong style="color: var(--accent); display: block; margin-bottom: 0.5rem;">Počet těles</strong>
        <span><%= @system_data['bodies'].count %></span>
      </div>

      <div class="metadata-item">
        <strong style="color: var(--accent); display: block; margin-bottom: 0.5rem;">Vzdálenost od černé díry</strong>
        <% distance = Math.sqrt((@system.x - 400)**2 + (@system.y - 400)**2) %>
        <span><%= format_distance_km(distance) %></span>
      </div>

      <% stars = @system_data['bodies'].select { |b| b['type'] == 'star' } %>
      <% if stars.any? %>
        <div class="metadata-item">
          <strong style="color: var(--accent); display: block; margin-bottom: 0.5rem;"><%= stars.size >= 2 ? "Dvojhvězda" : "Centrální hvězda" %></strong>
          <span><%= stars.map { |star| star['name'] }.join(" a ") %></span>
        </div>
      <% end %>

      <div class="metadata-item">
        <strong style="color: var(--accent); display: block; margin-bottom: 0.5rem;">Vytvořeno</strong>
        <span><%= @system.created_at.strftime('%d.%m.%Y %H:%M') %></span>
      </div>
    </div>
  </div>
</div>

<div class="content-section">
  <div class="card fade-in">
    <h3>Seznam těles v soustavě</h3>
    <table role="table" aria-label="Seznam nebeských těles v planetární soustavě" style="margin-top: 1rem;">
      <thead>
        <tr>
          <th scope="col">Název</th>
          <th scope="col">Typ</th>
          <th scope="col">Hmotnost (kg)</th>
          <th scope="col">Poloměr (m)</th>
          <th scope="col">Gravitační dilatace</th>
        </tr>
      </thead>
      <tbody>
        <% @system_data['bodies'].each do |body| %>
          <tr>
            <td><strong><%= body['name'] %></strong></td>
            <td>
              <% case body['type']
                 when 'star' %>⭐ Hvězda
              <% when 'planet' %>🪐 Planeta
              <% when 'moon' %>🌙 Měsíc
              <% else %><%= body['type'] %>
              <% end %>
            </td>
            <td><%= body['mass'] ? sprintf('%.2e', body['mass']) : 'N/A' %></td>
            <td><%= body['radius'] ? sprintf('%.2e', body['radius']) : 'N/A' %></td>
            <td><%= body['dilation'] ? (body['dilation'] * 100).round(6) : 0 %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="content-section">
  <div class="card fade-in">
    <h3>Schůzky v této soustavě</h3>
    <% system_meetings = @meetings.select { |m|
         m.system_id == @system.id ||
         (m.is_inter_system && m.participant_systems_hash.values.include?(@system.id))
       } %>

    <% if system_meetings.empty? %>
      <p style="color: rgba(255, 255, 255, 0.7); margin-top: 1rem;">
        V této soustavě zatím nebyly naplánovány žádné schůzky.
      </p>
      <%= link_to "Naplánovat schůzku", new_meeting_path(system_id: @system.id), class: "btn btn-primary", style: "margin-top: 1rem;" %>
    <% else %>
      <table role="table" aria-label="Seznam schůzek v této soustavě" style="margin-top: 1rem;">
        <thead>
          <tr>
            <th scope="col">Čas</th>
            <th scope="col">Téma</th>
            <th scope="col">Účastníci</th>
            <th scope="col">Akce</th>
          </tr>
        </thead>
        <tbody>
          <% system_meetings.each do |meeting| %>
            <tr>
              <td><%= meeting.start_time %> - <%= meeting.end_time %></td>
              <td><%= meeting.topic.present? ? meeting.topic : '<em>Bez tématu</em>'.html_safe %></td>
              <td><%= meeting.participants_array.join(', ') %></td>
              <td>
                <%= link_to "Upravit", edit_meeting_path(meeting), class: "btn btn-secondary btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%= link_to "Naplánovat schůzku", new_meeting_path(system_id: @system.id), class: "btn btn-primary", style: "margin-top: 1.25rem;", "aria-label" => "Naplánovat novou schůzku v této soustavě" %>
    <% end %>
  </div>
</div>

<%# Core systems are permanent: no regeneration (the controller refuses it too) %>
<% unless @system.core? %>
<div class="content-section">
  <div class="card fade-in">
    <h3>Parametry soustavy</h3>
    <%= form_with url: regenerate_galaxy_system_path(@system), method: :post, id: "system-regeneration-form", html: { onsubmit: "return confirm('Opravdu chcete regenerovat tuto soustavu? Všechna současná tělesa budou nahrazena novými.');" }, "aria-label" => "Formulář pro regenerování planetární soustavy" do |f| %>
      <p style="color: rgba(255, 255, 255, 0.8); margin-bottom: 1rem;">
        Můžete vygenerovat novou konfiguraci soustavy na stejné pozici v galaxii.
      </p>

      <div class="form-group">
        <%= label_tag :num_planets, "Počet planet (1-10):" %>
        <%= number_field_tag :num_planets, @system_data['bodies'].count { |b| b['type'] == 'planet' }, min: 1, max: 10, class: "form-control", id: "num-planets-field", "aria-describedby": "planets-help", "aria-required": "true" %>
        <small id="planets-help" style="color: var(--text); opacity: 0.8;">Kolik planet obíhá kolem hvězdy</small>
      </div>

      <div class="form-group">
        <%= label_tag :max_moons_per_planet, "Maximální počet měsíců (0-5):" %>
        <% current_max_moons = @system_data['bodies'].count { |b| b['type'] == 'moon' } / [@system_data['bodies'].count { |b| b['type'] == 'planet' }, 1].max %>
        <%= number_field_tag :max_moons_per_planet, [current_max_moons.ceil, 2].max, min: 0, max: 5, class: "form-control", id: "max-moons-field", "aria-describedby": "moons-help", "aria-required": "true" %>
        <small id="moons-help" style="color: var(--text); opacity: 0.8;">Maximální počet měsíců pro každou planetu</small>
      </div>

      <div class="actions">
        <%= submit_tag "Regenerovat soustavu", class: "btn btn-accent", id: "regenerate-button", "aria-label": "Regenerovat planetární soustavu s novými parametry" %>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<% if @system_svg.present? %>
  <%# Planets and moons wear light tints of the system colour (as on the galaxy map) %>
  <div class="svg-container fade-in system-svg" role="img" aria-label="Interaktivní mapa planetární soustavy <%= @system.name %>"
       style="--system-color: <%= system_color(@system.id) %>; --tone-0: <%= system_tint(@system.id, 0.2) %>; --tone-1: <%= system_tint(@system.id, 0.4) %>; --tone-2: <%= system_tint(@system.id, 0.55) %>; --tone-moon: <%= system_tint(@system.id, 0.7) %>;">
    <%= raw @system_svg %>
  </div>

  <!-- Tooltip for celestial body information -->
  <div id="tooltip" role="tooltip" aria-live="polite"></div>

  <!-- Interactive map features: tooltips + orbital animation -->
  <script src="<%= asset_path('system_map.js') %>"></script>
  <script src="<%= asset_path('orbital_animation.js') %>"></script>
<% else %>
  <div class="content-section">
    <div class="card fade-in">
      <p style="color: rgba(255, 255, 255, 0.7);">Vizualizace soustavy se nepodařila načíst. Zkuste obnovit stránku nebo regenerovat soustavu.</p>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('system-regeneration-form');
    const numPlanetsField = document.getElementById('num-planets-field');
    const maxMoonsField = document.getElementById('max-moons-field');
    const submitButton = document.getElementById('regenerate-button');
    if (!form) return;

    function validateForm() {
      const numPlanets = parseInt(numPlanetsField.value, 10);
      const maxMoons = parseInt(maxMoonsField.value, 10);

      let isValid = true;

      // Validate num_planets (1-10)
      if (isNaN(numPlanets) || numPlanets < 1 || numPlanets > 10) {
        isValid = false;
      }

      // Validate max_moons (0-5)
      if (isNaN(maxMoons) || maxMoons < 0 || maxMoons > 5) {
        isValid = false;
      }

      submitButton.disabled = !isValid;
      return isValid;
    }

    // Validate on input
    numPlanetsField.addEventListener('input', validateForm);
    maxMoonsField.addEventListener('input', validateForm);

    // Validate on form submission
    form.addEventListener('submit', function(e) {
      if (!validateForm()) {
        e.preventDefault();
        alert('Prosím zadejte platné hodnoty: Počet planet (1-10), Měsíce (0-5)');
      }
    });

    // Initial validation
    validateForm();
  });
</script>

