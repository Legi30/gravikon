<% content_for :body_class, "system-page" %>
<% profile = @profile %>
<% bodies_by_name = @bodies.index_by { |body| body["name"] } %>
<% tones = "--system-color: #{system_color(@system.id)}; --system-tint: #{system_tint(@system.id)};" %>

<%# The system page in the landing's language: no boxes, the live orbit map as
    the hero, then the inhabitants (with mass and size), relations and meetings %>
<div class="system-detail" style="<%= tones %>">
  <header class="system-detail-head">
    <p class="system-detail-back"><%= link_to "Všechny soustavy", galaxy_systems_path %></p>
    <h1 class="system-title"><span class="system-dot" aria-hidden="true"></span><%= @system.name %></h1>
    <% if profile %>
      <p class="profile-intro"><%= system_intro(profile) %></p>
      <dl class="profile-facts">
        <div>
          <dt>od černé díry</dt>
          <dd><%= format_distance_km(profile[:distance]) %></dd>
        </div>
        <div>
          <dt>za vaši hodinu</dt>
          <dd><%= format_minutes(profile[:rate] * 60) %> min</dd>
        </div>
        <div>
          <dt>obyvatelé</dt>
          <dd><%= cs_count(profile[:planets].size, "planeta", "planety", "planet") %>, <%= cs_count(profile[:moon_count], "měsíc", "měsíce", "měsíců") %></dd>
        </div>
      </dl>
    <% end %>

    <% unless @system.core? %>
      <nav class="system-detail-actions" aria-label="Akce se soustavou">
        <%= link_to "Upravit soustavu", edit_galaxy_system_path(@system), class: "profile-link" %>
        <%= button_to "Smazat", galaxy_system_path(@system), method: :delete, form: { onsubmit: "return confirm('Opravdu chcete smazat soustavu #{j @system.name}? Tato akce je nevratná.');", class: "inline-form" }, class: "link-button link-button--danger", "aria-label" => "Smazat soustavu" %>
      </nav>
    <% end %>
  </header>

  <% if @system_svg.present? %>
    <%# Planets and moons wear light tints of the system colour (as on the galaxy map) %>
    <%# data-tilt: orbital_animation.js shows the system at an angle (like the galaxy map) %>
    <div class="svg-container system-svg" data-tilt data-black-hole-dilation="<%= profile ? profile[:rate].round(6) : "" %>" role="img" aria-label="Interaktivní mapa planetární soustavy <%= @system.name %>"
         style="--tone-0: <%= system_tint(@system.id, 0.2) %>; --tone-1: <%= system_tint(@system.id, 0.4) %>; --tone-2: <%= system_tint(@system.id, 0.55) %>; --tone-moon: <%= system_tint(@system.id, 0.7) %>;">
      <%= raw @system_svg %>
    </div>
    <p class="system-svg-hint">Najeďte na těleso a uvidíte, jak rychle na něm plyne čas.</p>

    <!-- Tooltip for celestial body information -->
    <div id="tooltip" role="tooltip" aria-live="polite"></div>
  <% else %>
    <p class="profile-hint">Vizualizace soustavy se nepodařila načíst. Zkuste obnovit stránku nebo soustavu přegenerovat.</p>
  <% end %>

  <% if profile %>
    <div class="system-detail-body">
      <section class="profile-block system-inhabitants" aria-labelledby="inhabitants-heading">
        <h2 id="inhabitants-heading">Kdo tu žije</h2>
        <p class="profile-story"><%= system_story(profile) %></p>
        <p class="profile-hint">Kolik minut uběhne na každém tělese, zatímco vám uběhne hodina, a jak je těleso těžké a velké:</p>
        <ul class="body-list">
          <% rows = profile[:stars].map { |star| [ star, (profile[:stars].size >= 2 ? "dvojhvězda" : "hvězda"), :star ] } %>
          <% profile[:planets].each do |planet| %>
            <% rows << [ planet, "planeta", :planet ] %>
            <% planet[:moons].each { |moon| rows << [ moon, "měsíc", :moon ] } %>
          <% end %>
          <% rows.each do |body, label, kind| %>
            <% raw_body = bodies_by_name[body[:name]] || {} %>
            <li class="body-row body-row--<%= kind %>">
              <span class="body-name"><%= body[:name] %> <small><%= label %></small></span>
              <span class="body-physics">
                <span><%= format_mass(raw_body["mass"]) %></span>
                <span>poloměr <%= format_radius_km(raw_body["radius"]) %></span>
              </span>
              <span class="inhabitant-track"><span class="inhabitant-bar" style="width: <%= (body[:dilation] * 100).clamp(0, 100).round(1) %>%;"></span></span>
              <span class="inhabitant-value"><%= format_minutes(body[:dilation] * 60) %> min</span>
            </li>
          <% end %>
        </ul>
      </section>

      <div class="system-detail-side">
        <section class="profile-block" aria-labelledby="relations-heading">
          <h2 id="relations-heading">Vztahy s ostatními</h2>
          <% if profile[:relations].empty? %>
            <p class="profile-hint">V galaxii zatím není žádná jiná soustava.</p>
          <% else %>
            <p class="profile-hint">Jak dlouho k nim letí signál a kolik u nich uběhne, zatímco tady uplyne hodina.</p>
            <ul class="relation-list">
              <% profile[:relations].each do |relation| %>
                <li class="relation" style="--other-color: <%= system_color(relation[:system].id) %>;">
                  <span class="relation-name"><span class="system-dot system-dot--other" aria-hidden="true"></span><%= link_to relation[:system].name, galaxy_system_path(relation[:system]) %></span>
                  <span class="relation-facts">
                    <span>signál <strong><%= format_delay_display(relation[:signal_delay]) %></strong></span>
                    <% if relation[:minutes_there_per_hour_here] %>
                      <span>hodina tady = <strong><%= format_minutes(relation[:minutes_there_per_hour_here]) %> min</strong> tam</span>
                    <% end %>
                  </span>
                </li>
              <% end %>
            </ul>
          <% end %>
        </section>

        <section class="profile-block" aria-labelledby="meetings-heading">
          <h2 id="meetings-heading">Schůzky</h2>
          <% if profile[:meetings].empty? %>
            <p class="profile-hint">Tady se zatím nikdo nesešel.</p>
          <% else %>
            <ul class="profile-meeting-list">
              <% profile[:meetings].each do |meeting| %>
                <li>
                  <span class="pm-time"><%= "#{meeting.start_time}–#{meeting.end_time}" %></span>
                  <span class="pm-topic">
                    <%= link_to (meeting.topic.presence || "(bez tématu)"), edit_meeting_path(meeting) %>
                    <% if meeting.is_inter_system %><span class="pm-badge">mezi soustavami</span><% end %>
                  </span>
                  <span class="pm-stats"><%= meeting.participants_array.join(", ") %></span>
                </li>
              <% end %>
            </ul>
          <% end %>
          <p class="system-detail-cta"><%= link_to "Naplánovat tu schůzku", new_meeting_path(system_id: @system.id), class: "profile-link", "aria-label" => "Naplánovat novou schůzku v této soustavě" %></p>
        </section>
      </div>
    </div>
  <% end %>

  <%# Core systems are permanent: no regeneration (the controller refuses it too) %>
  <% unless @system.core? %>
    <section class="profile-block system-regenerate" aria-labelledby="regenerate-heading">
      <h2 id="regenerate-heading">Přegenerovat soustavu</h2>
      <%= form_with url: regenerate_galaxy_system_path(@system), method: :post, id: "system-regeneration-form", html: { onsubmit: "return confirm('Opravdu chcete regenerovat tuto soustavu? Všechna současná tělesa budou nahrazena novými.');" }, "aria-label" => "Formulář pro regenerování planetární soustavy" do |f| %>
        <p class="profile-hint">Na stejném místě v galaxii vznikne nová hvězda s novými planetami a měsíci.</p>

        <div class="form-row">
          <div class="form-group">
            <%= label_tag :num_planets, "Počet planet (1–10)" %>
            <%= number_field_tag :num_planets, @system_data['bodies'].count { |b| b['type'] == 'planet' }, min: 1, max: 10, class: "form-control", id: "num-planets-field", "aria-required": "true" %>
          </div>

          <div class="form-group">
            <%= label_tag :max_moons_per_planet, "Nejvýš měsíců na planetu (0–5)" %>
            <% current_max_moons = @system_data['bodies'].count { |b| b['type'] == 'moon' } / [@system_data['bodies'].count { |b| b['type'] == 'planet' }, 1].max %>
            <%= number_field_tag :max_moons_per_planet, [current_max_moons.ceil, 2].max, min: 0, max: 5, class: "form-control", id: "max-moons-field", "aria-required": "true" %>
          </div>
        </div>

        <div class="actions">
          <%= submit_tag "Přegenerovat soustavu", class: "btn btn-secondary", id: "regenerate-button", "aria-label": "Regenerovat planetární soustavu s novými parametry" %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>

<% if @system_svg.present? %>
  <!-- Interactive map features: tooltips + orbital animation + signals between bodies -->
  <script src="<%= asset_path('system_map.js') %>"></script>
  <script src="<%= asset_path('orbital_animation.js') %>"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const svg = document.querySelector('.system-svg svg');
      if (!svg || !window.GalaxyInteractions) return;

      // Planets and moons call each other (decorative, like the galaxy map)
      const bodies = Array.from(svg.querySelectorAll('.celestial-body')).filter(el => el.getAttribute('data-type') !== 'star');
      const color = getComputedStyle(document.querySelector('.system-detail')).getPropertyValue('--system-tint').trim() || '#ffffff';
      const point = (el) => () => ({ x: parseFloat(el.getAttribute('cx')), y: parseFloat(el.getAttribute('cy')) });
      const pick = (list) => list[Math.floor(Math.random() * list.length)];

      window.GalaxyInteractions.runSignals(svg, function() {
        if (bodies.length < 2) return null;
        const a = pick(bodies);
        const b = pick(bodies.filter(el => el !== a));
        return { from: point(a), to: point(b), color: color, scale: 1.4 };
      });
    });
  </script>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('system-regeneration-form');
    const numPlanetsField = document.getElementById('num-planets-field');
    const maxMoonsField = document.getElementById('max-moons-field');
    const submitButton = document.getElementById('regenerate-button');
    if (!form) return;

    function validateForm() {
      const numPlanets = parseInt(numPlanetsField.value, 10);
      const maxMoons = parseInt(maxMoonsField.value, 10);

      let isValid = true;

      // Validate num_planets (1-10)
      if (isNaN(numPlanets) || numPlanets < 1 || numPlanets > 10) {
        isValid = false;
      }

      // Validate max_moons (0-5)
      if (isNaN(maxMoons) || maxMoons < 0 || maxMoons > 5) {
        isValid = false;
      }

      submitButton.disabled = !isValid;
      return isValid;
    }

    // Validate on input
    numPlanetsField.addEventListener('input', validateForm);
    maxMoonsField.addEventListener('input', validateForm);

    // Validate on form submission
    form.addEventListener('submit', function(e) {
      if (!validateForm()) {
        e.preventDefault();
        alert('Prosím zadejte platné hodnoty: Počet planet (1-10), Měsíce (0-5)');
      }
    });

    // Initial validation
    validateForm();
  });
</script>
