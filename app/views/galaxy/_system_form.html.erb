<%# System create/edit form.
    locals:
      system, url, method, form_label, submit_text, cancel_path
      suggested_position - optional {x:, y:} prefilled into empty coordinates %>
<% suggested_position = local_assigns[:suggested_position] %>
<% prefill_x = system.x.presence || suggested_position&.dig(:x) %>
<% prefill_y = system.y.presence || suggested_position&.dig(:y) %>
<%= form_with model: system, url: url, method: method, id: "system-form", "aria-label" => form_label do |f| %>
  <div class="form-group">
    <%= f.label :name, "Název", for: "system_name" %>
    <%= f.text_field :name, placeholder: "např. Sluneční soustava", id: "system_name", class: "form-control", "aria-describedby": "name-error name-help", "aria-required": "true", required: true %>
    <small id="name-help" class="form-hint">3 až 50 znaků, v galaxii jedinečný</small>
    <div id="name-error" class="error-message" style="display: none;" role="alert" aria-live="polite"></div>
  </div>

  <div class="form-row">
  <div class="form-group">
    <%= f.label :x, "Pozice X", for: "system_x" %>
    <%= f.number_field :x, value: prefill_x, min: 0, max: 800, step: 0.1, id: "system_x", class: "form-control", "aria-describedby": "x-error x-help", "aria-required": "true", required: true %>
    <small id="x-help" class="form-hint">0–800, černá díra je na 400</small>
    <div id="x-error" class="error-message" style="display: none;" role="alert" aria-live="polite"></div>
    <% if system.x.present? && (system.x < 100 || system.x > 700) %>
      <div class="warning-message" style="color: #f39c12; margin-top: 0.5rem;" role="alert">
        ⚠ Varování: Soustava je mimo doporučený rozsah (100-700)
      </div>
    <% end %>
  </div>

  <div class="form-group">
    <%= f.label :y, "Pozice Y", for: "system_y" %>
    <%= f.number_field :y, value: prefill_y, min: 0, max: 800, step: 0.1, id: "system_y", class: "form-control", "aria-describedby": "y-error y-help", "aria-required": "true", required: true %>
    <small id="y-help" class="form-hint">0–800, černá díra je na 400</small>
    <div id="y-error" class="error-message" style="display: none;" role="alert" aria-live="polite"></div>
    <% if system.y.present? && (system.y < 100 || system.y > 700) %>
      <div class="warning-message" style="color: #f39c12; margin-top: 0.5rem;" role="alert">
        ⚠ Varování: Soustava je mimo doporučený rozsah (100-700)
      </div>
    <% end %>
  </div>

  </div>

  <div class="position-validation-display" id="position-validation" style="display: none; margin-top: 1rem; padding: 1rem; border-radius: 6px;" role="status" aria-live="polite">
    <!-- JavaScript will populate this with validation messages -->
  </div>

  <% if system.new_record? %>
    <%# Generation parameters only make sense when creating — editing an
        existing system changes name/position; planet counts are changed
        via the regenerate action on the detail page %>
    <div class="form-row">
    <div class="form-group">
      <%= f.label :num_planets, "Počet planet (1–10)", for: "system_num_planets" %>
      <%= f.number_field :num_planets, min: 1, max: 10, value: 5, id: "system_num_planets", class: "form-control", "aria-describedby": "planets-error", "aria-required": "true", required: true %>

      <div id="planets-error" class="error-message" style="display: none;" role="alert" aria-live="polite"></div>
    </div>

    <div class="form-group">
      <%= f.label :max_moons_per_planet, "Nejvýš měsíců na planetu (0–5)", for: "system_max_moons" %>
      <%= f.number_field :max_moons_per_planet, min: 0, max: 5, value: 2, id: "system_max_moons", class: "form-control", "aria-describedby": "moons-error", "aria-required": "true", required: true %>
      <div id="moons-error" class="error-message" style="display: none;" role="alert" aria-live="polite"></div>
    </div>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit submit_text, class: "btn btn-primary", id: "submit-button", "aria-label": submit_text %>
    <%= link_to "Zrušit", cancel_path, class: "btn btn-secondary" %>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('system-form');
    const nameField = document.getElementById('system_name');
    const xField = document.getElementById('system_x');
    const yField = document.getElementById('system_y');
    const numPlanetsField = document.getElementById('system_num_planets'); // null on edit
    const maxMoonsField = document.getElementById('system_max_moons');     // null on edit
    const submitButton = document.getElementById('submit-button');
    const positionValidation = document.getElementById('position-validation');

    const nameError = document.getElementById('name-error');
    const xError = document.getElementById('x-error');
    const yError = document.getElementById('y-error');
    const planetsError = document.getElementById('planets-error');
    const moonsError = document.getElementById('moons-error');

    // Constants for validation
    const GALAXY_CENTER = [400, 400];
    const MIN_DISTANCE_FROM_BLACK_HOLE = 50;
    const CANVAS_SIZE = 800;

    function showError(element, message) {
      element.textContent = message;
      element.style.display = 'block';
      element.parentElement.querySelector('.form-control')?.classList.add('error');
    }

    function hideError(element) {
      element.textContent = '';
      element.style.display = 'none';
      element.parentElement.querySelector('.form-control')?.classList.remove('error');
    }

    function validateName(showErrors) {
      const name = nameField.value.trim();
      let message = null;
      if (name.length === 0) message = 'Název musí být vyplněn';
      else if (name.length < 3) message = 'Název musí mít alespoň 3 znaky';
      else if (name.length > 50) message = 'Název může mít maximálně 50 znaků';

      if (message && showErrors) showError(nameError, message);
      else hideError(nameError);
      return !message;
    }

    function validateCoordinate(field, errorElement, coordinateName, showErrors) {
      const value = parseFloat(field.value);
      let message = null;
      if (isNaN(value)) message = `${coordinateName} musí být číslo`;
      else if (value < 0 || value > CANVAS_SIZE) message = `${coordinateName} musí být v rozsahu 0-${CANVAS_SIZE}`;

      if (message && showErrors) showError(errorElement, message);
      else hideError(errorElement);
      return !message;
    }

    function validatePosition() {
      const x = parseFloat(xField.value);
      const y = parseFloat(yField.value);

      if (isNaN(x) || isNaN(y)) {
        positionValidation.style.display = 'none';
        return true; // Skip if coordinates not fully entered yet
      }

      // Check distance from black hole
      const distanceFromCenter = Math.sqrt(
        Math.pow(x - GALAXY_CENTER[0], 2) + Math.pow(y - GALAXY_CENTER[1], 2)
      );

      positionValidation.style.display = 'block';

      if (distanceFromCenter < MIN_DISTANCE_FROM_BLACK_HOLE) {
        positionValidation.style.background = 'rgba(231, 76, 60, 0.1)';
        positionValidation.style.border = '1px solid #e74c3c';
        positionValidation.style.color = '#e74c3c';
        positionValidation.innerHTML = `❌ <strong>Chyba:</strong> Soustava je příliš blízko černé díře (vzdálenost: ${Math.round(distanceFromCenter * 1000).toLocaleString('cs-CZ')} km, minimum: ${(MIN_DISTANCE_FROM_BLACK_HOLE * 1000).toLocaleString('cs-CZ')} km)`;
        return false;
      }

      // Check recommended range
      if (x < 100 || x > 700 || y < 100 || y > 700) {
        positionValidation.style.background = 'rgba(243, 156, 18, 0.1)';
        positionValidation.style.border = '1px solid #f39c12';
        positionValidation.style.color = '#f39c12';
        positionValidation.innerHTML = '⚠ <strong>Varování:</strong> Pozice je mimo doporučený rozsah (100-700). Soustava může být příliš blízko okraje.';
        return true; // Warning, not error
      }

      // Valid position
      positionValidation.style.background = 'rgba(46, 213, 115, 0.1)';
      positionValidation.style.border = '1px solid #2ed573';
      positionValidation.style.color = '#2ed573';
      positionValidation.innerHTML = `✓ <strong>Platná pozice</strong> (od černé díry ${Math.round(distanceFromCenter * 1000).toLocaleString('cs-CZ')} km)`;
      return true;
    }

    function validateNumeric(field, errorElement, label, min, max, showErrors) {
      if (!field) return true; // generation fields are absent on the edit form
      const value = parseInt(field.value, 10);
      let message = null;
      if (isNaN(value)) message = `${label} musí být číslo`;
      else if (value < min || value > max) message = `${label} musí být v rozsahu ${min}-${max}`;

      if (message && showErrors) showError(errorElement, message);
      else hideError(errorElement);
      return !message;
    }

    // Errors are shown only after the user interacts with the form — the
    // pristine form just keeps the submit button disabled when incomplete.
    function validateForm(showErrors) {
      const nameValid = validateName(showErrors);
      const xValid = validateCoordinate(xField, xError, 'X souřadnice', showErrors);
      const yValid = validateCoordinate(yField, yError, 'Y souřadnice', showErrors);
      const positionValid = validatePosition();
      const planetsValid = validateNumeric(numPlanetsField, planetsError, 'Počet planet', 1, 10, showErrors);
      const moonsValid = validateNumeric(maxMoonsField, moonsError, 'Počet měsíců', 0, 5, showErrors);

      const isValid = nameValid && xValid && yValid && positionValid && planetsValid && moonsValid;
      submitButton.disabled = !isValid;
      return isValid;
    }

    // Attach event listeners
    [nameField, xField, yField, numPlanetsField, maxMoonsField].forEach(function(field) {
      if (field) field.addEventListener('input', function() { validateForm(true); });
    });

    // Validate on form submission
    form.addEventListener('submit', function(e) {
      if (!validateForm(true)) {
        e.preventDefault();
        alert('Prosím opravte chyby ve formuláři před odesláním.');
      }
    });

    // Initial validation: set submit state without flashing errors
    validateForm(false);
  });
</script>

<style>
  .form-control.error {
    border-color: #e74c3c;
    background: rgba(231, 76, 60, 0.05);
  }

  .error-message {
    color: #e74c3c;
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  .warning-message {
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-control {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text);
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.08);
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: var(--text);
  }

  small {
    display: block;
    margin-top: 0.5rem;
  }
</style>
