<% content_for :body_class, "system-form-page" %>

<div class="system-form-layout" style="--system-color: <%= system_color(@system.id) %>; --system-tint: <%= system_tint(@system.id) %>;">
  <div class="system-form-main">
    <header class="page-header">
      <p class="system-detail-back"><%= link_to @system.name, galaxy_system_path(@system) %></p>
      <h1>Upravit soustavu</h1>
      <p>
        Změnit můžete název a místo v galaxii. S novým místem se změní i rychlost, jakou tam plyne čas.
        Jiný počet planet nebo měsíců dostanete přegenerováním na stránce soustavy.
      </p>
    </header>

    <%= render partial: 'system_form',
               locals: {
                 system: @system,
                 url: galaxy_system_path(@system),
                 method: :patch,
                 form_label: "Formulář pro úpravu planetární soustavy",
                 submit_text: "Uložit změny",
                 cancel_path: galaxy_system_path(@system)
               } %>
  </div>

  <aside class="system-form-map" aria-labelledby="picker-heading">
    <h2 id="picker-heading">Místo v galaxii</h2>
    <p class="profile-hint">Kroužek se posouvá podle zadaných souřadnic.</p>

    <div id="position-preview">
      <svg viewBox="0 0 800 800" style="width: 100%; height: 100%;">
        <!-- Black hole at center -->
        <circle cx="400" cy="400" r="30" fill="#000" stroke="#ffd28a" stroke-width="2" opacity="0.9"/>
        <circle cx="400" cy="400" r="50" fill="none" stroke="#e74c3c" stroke-width="2" stroke-dasharray="5,5" opacity="0.5"/>

        <!-- Current system position -->
        <circle id="system-marker" cx="<%= @system.x %>" cy="<%= @system.y %>" r="15" fill="var(--system-tint)" stroke="var(--system-color)" stroke-width="2"/>
        <text x="<%= @system.x %>" y="<%= @system.y - 25 %>" text-anchor="middle" fill="var(--system-tint)" font-size="16" font-weight="bold"><%= @system.name %></text>

        <!-- Other systems for reference -->
        <%# class/data-* let galaxy.js validatePosition check the spacing rule client-side %>
        <% System.where.not(id: @system.id).each do |other_system| %>
          <circle cx="<%= other_system.x %>" cy="<%= other_system.y %>" r="40" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="2" stroke-dasharray="6,5"/>
          <circle cx="<%= other_system.x %>" cy="<%= other_system.y %>" r="10" fill="rgba(255,255,255,0.3)" stroke="rgba(255,255,255,0.5)" stroke-width="1"
                  class="system-marker" data-x="<%= other_system.x %>" data-y="<%= other_system.y %>" data-system-name="<%= other_system.name %>"/>
        <% end %>
      </svg>
    </div>

    <ul class="position-legend">
      <li><span class="legend-ring legend-ring-black-hole" aria-hidden="true"></span>k černé díře aspoň <%= format_distance_km(50) %></li>
      <li><span class="legend-ring legend-ring-system" aria-hidden="true"></span>k jiné soustavě aspoň <%= format_distance_km(40) %></li>
      <li><span class="legend-dot" style="background: var(--system-tint);" aria-hidden="true"></span>soustava <%= @system.name %></li>
    </ul>
  </aside>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Update position preview when coordinates change
    const xField = document.getElementById('system_x');
    const yField = document.getElementById('system_y');
    const systemMarker = document.getElementById('system-marker');

    function updatePreview() {
      const x = parseFloat(xField.value);
      const y = parseFloat(yField.value);

      if (!isNaN(x) && !isNaN(y)) {
        systemMarker.setAttribute('cx', x);
        systemMarker.setAttribute('cy', y);

        // Update text position
        const textElement = systemMarker.nextElementSibling;
        if (textElement && textElement.tagName === 'text') {
          textElement.setAttribute('x', x);
          textElement.setAttribute('y', y - 25);
        }
      }
    }

    xField.addEventListener('input', updatePreview);
    yField.addEventListener('input', updatePreview);
  });
</script>
