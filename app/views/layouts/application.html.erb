<!DOCTYPE html>
<html lang="cs">
  <head>
    <title><%= content_for(:title) || "Gravikon - Relativistický schůzkovač" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="Gravikon plánuje schůzky mezi hvězdnými soustavami kolem černé díry a počítá, jak dlouho je kdo prožije a jak dlouho k sobě letí jejich slova.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Google Fonts - Oxanium for headings (full Czech diacritics; Orbitron lacked ů ř ě č š ž), Inter for body %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Oxanium:wght@600;700;800&display=swap" rel="stylesheet">

    <%# application.css is the manifest — it @imports the other stylesheets
        in cascade order (gravikon base first) %>
    <%= stylesheet_link_tag "application" %>
  </head>

  <body class="<%= yield :body_class %>">
    <!-- Skip to main content link for screen readers -->
    <a href="#main-content" class="skip-to-content">Přeskočit na hlavní obsah</a>

    <!-- Navigation Header -->
    <nav class="main-nav" role="navigation" aria-label="Hlavní navigace">
      <div class="nav-container">
        <div class="nav-brand">
          <%= link_to root_path, class: "brand-link", "aria-label" => "Gravikon - Domovská stránka" do %>
            <%# The galaxy's black hole in miniature: shadow, lensed arc, disc crossing in front %>
            <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
              <ellipse cx="16" cy="16.5" rx="14" ry="4.3" fill="none" stroke="#f0a040" stroke-width="1.6" opacity="0.5"/>
              <path d="M6.6 16.5 A9.4 9.4 0 0 1 25.4 16.5" fill="none" stroke="#ffc46b" stroke-width="1.8" opacity="0.85"/>
              <circle cx="16" cy="16.5" r="7.4" fill="#000" stroke="#ffe7bf" stroke-width="0.8"/>
              <path d="M2 16.5 A14 4.3 0 0 0 30 16.5" fill="none" stroke="#ffd27a" stroke-width="2.2" stroke-linecap="round"/>
            </svg>
            <span class="brand-text">Gravikon</span>
          <% end %>
        </div>
        <div class="nav-links">
          <%= link_to galaxy_index_path, class: "nav-link #{'active' if current_page?(galaxy_index_path) || current_page?(root_path)}", "aria-label" => "Galaxie - klávesová zkratka G", title: "Galaxie (klávesová zkratka: G)" do %>
            <span>Galaxie</span>
          <% end %>
          <%= link_to galaxy_systems_path, class: "nav-link #{'active' if current_page?(galaxy_systems_path)}", "aria-label" => "Soustavy" do %>
            <span>Soustavy</span>
          <% end %>
          <%= link_to meetings_path, class: "nav-link #{'active' if current_page?(meetings_path)}", "aria-label" => "Schůzky - klávesová zkratka S", title: "Schůzky (klávesová zkratka: S)" do %>
            <span>Schůzky</span>
          <% end %>
          <%= link_to about_path, class: "nav-link #{'active' if current_page?(about_path)}", "aria-label" => "O aplikaci - klávesová zkratka O", title: "O aplikaci (klávesová zkratka: O)" do %>
            <span>O aplikaci</span>
          <% end %>
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <main id="main-content" class="container" role="main" aria-label="Hlavní obsah">
      <% flash.each do |type, message| %>
        <div class="flash flash-<%= type %>" role="alert"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>

    <!-- Load logger first (production-safe logging) -->
    <script src="<%= asset_path('logger.js') %>"></script>
    <!-- Include keyboard shortcuts JavaScript -->
    <script src="<%= asset_path('keyboard_shortcuts.js') %>"></script>
    <!-- Galaxy map interactive features -->
    <script src="<%= asset_path('galaxy.js') %>"></script>
  </body>
</html>
