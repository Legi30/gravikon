<!DOCTYPE html>
<html lang="cs">
  <head>
    <title><%= content_for(:title) || "Gravikon - Relativistický schůzkovač" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="Gravitační schůzkovač s podporou relativistických efektů v planetární soustavě">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Google Fonts - Oxanium for headings (full Czech diacritics; Orbitron lacked ů ř ě č š ž), Inter for body %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Oxanium:wght@600;700;800&display=swap" rel="stylesheet">

    <%# application.css is the manifest — it @imports the other stylesheets
        in cascade order (gravikon base first) %>
    <%= stylesheet_link_tag "application" %>
  </head>

  <body class="<%= yield :body_class %>">
    <!-- Skip to main content link for screen readers -->
    <a href="#main-content" class="skip-to-content">Přeskočit na hlavní obsah</a>

    <!-- Navigation Header -->
    <nav class="main-nav" role="navigation" aria-label="Hlavní navigace">
      <div class="nav-container">
        <div class="nav-brand">
          <%= link_to root_path, class: "brand-link", "aria-label" => "Gravikon - Domovská stránka" do %>
            <span class="brand-icon" aria-hidden="true">🌌</span>
            <span class="brand-text">Gravikon</span>
          <% end %>
        </div>
        <div class="nav-links">
          <%= link_to galaxy_index_path, class: "nav-link #{'active' if current_page?(galaxy_index_path) || current_page?(root_path)}", "aria-label" => "Galaxie - klávesová zkratka G", title: "Galaxie (klávesová zkratka: G)" do %>
            <span class="nav-icon" aria-hidden="true">🌌</span>
            <span>Galaxie</span>
          <% end %>
          <%= link_to meetings_path, class: "nav-link #{'active' if current_page?(meetings_path)}", "aria-label" => "Schůzky - klávesová zkratka S", title: "Schůzky (klávesová zkratka: S)" do %>
            <span class="nav-icon" aria-hidden="true">📅</span>
            <span>Schůzky</span>
          <% end %>
          <%= link_to dashboard_path, class: "nav-link #{'active' if current_page?(dashboard_path)}", "aria-label" => "Přehled - klávesová zkratka D", title: "Přehled (klávesová zkratka: D)" do %>
            <span class="nav-icon" aria-hidden="true">📊</span>
            <span>Přehled</span>
          <% end %>
          <%= link_to about_path, class: "nav-link #{'active' if current_page?(about_path)}", "aria-label" => "O aplikaci - klávesová zkratka O", title: "O aplikaci (klávesová zkratka: O)" do %>
            <span class="nav-icon" aria-hidden="true">🔭</span>
            <span>O aplikaci</span>
          <% end %>
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <main id="main-content" class="container" role="main" aria-label="Hlavní obsah">
      <% flash.each do |type, message| %>
        <div class="flash flash-<%= type %>" role="alert"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>

    <!-- Load logger first (production-safe logging) -->
    <script src="<%= asset_path('logger.js') %>"></script>
    <!-- Include keyboard shortcuts JavaScript -->
    <script src="<%= asset_path('keyboard_shortcuts.js') %>"></script>
    <!-- Galaxy map interactive features -->
    <script src="<%= asset_path('galaxy.js') %>"></script>
  </body>
</html>
