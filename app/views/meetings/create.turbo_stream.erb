<%
  # Load system_data for the partial rendering
  @system_data ||= Rails.cache.fetch('system_data') do
    JSON.parse(File.read(Rails.root.join("data/system_data.json")))
  rescue Errno::ENOENT, JSON::ParserError => e
    Rails.logger.error("create.turbo_stream.erb: Failed to load system_data - #{e.message}")
    { "bodies" => [] }
  end
%>
<%= turbo_stream.append "meetings-table" do %>
  <%= render partial: 'meeting', locals: { meeting: @meeting, system_data: @system_data } %>
<% end %>
<%= turbo_stream.update "empty-state-container", "" %>
<%= turbo_stream.update "flash-messages" do %>
  <div class="notice">
    Schůzka naplánována.
  </div>
<% end %>
