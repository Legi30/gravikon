<%
  is_inter_system = local_assigns.fetch(:is_inter_system, false)
  show_system_column = local_assigns.fetch(:show_system_column, false)
  calculator = @relativistic_calculator || RelativisticCalculator.new
  base_duration = meeting.duration_minutes

  # Each participant's system, body and dilation (resolved once, shared with the row)
  participant_info = meeting_participants_info(meeting)
  participants = participant_info.keys

  # Pairwise signal delays (seconds)
  pair_delays = participants.combination(2).filter_map do |p1, p2|
    i1 = participant_info[p1]
    i2 = participant_info[p2]
    next unless i1[:system_id] && i2[:system_id] && i1[:body] && i2[:body]

    distance = calculator.calculate_body_to_body_distance(i1[:body], i1[:system_id], i2[:body], i2[:system_id])
    { p1: p1, p2: p2, delay: calculator.calculate_signal_delay(distance) }
  end
  max_delay = pair_delays.map { |pair| pair[:delay] }.max

  # Big meetings would list every pair (19 participants = 171 rows): across
  # systems the pairs are grouped per system pair (average delay), inside one
  # system only the longest connections are shown
  max_pair_rows = 12
  systems_by_id = participant_info.values.filter_map { |info| [ info[:system_id], info[:system] ] if info[:system] }.to_h
  grouped = systems_by_id.size > 1 && pair_delays.size > max_pair_rows
  if grouped
    delay_rows = pair_delays.group_by { |pair| [ participant_info[pair[:p1]][:system_id], participant_info[pair[:p2]][:system_id] ].sort }
                            .map do |(from_id, to_id), pairs|
      { from_id: from_id, to_id: to_id, count: pairs.size, delay: pairs.sum { |pair| pair[:delay] } / pairs.size,
        label: from_id == to_id ? "uvnitř #{systems_by_id[from_id]&.name}" : "#{systems_by_id[from_id]&.name} ↔ #{systems_by_id[to_id]&.name}" }
    end.sort_by { |row| -row[:delay] }
  else
    delay_rows = pair_delays.sort_by { |pair| -pair[:delay] }.first(max_pair_rows).map do |pair|
      { from_id: participant_info[pair[:p1]][:system_id], to_id: participant_info[pair[:p2]][:system_id],
        delay: pair[:delay], label: "#{pair[:p1]} ↔ #{pair[:p2]}" }
    end
  end
  hidden_pairs = grouped ? 0 : pair_delays.size - delay_rows.size
  max_row_delay = delay_rows.map { |row| row[:delay] }.max
%>
<%# Two side-by-side lists straight on the row's background (no inner boxes):
    how long each participant lives through the meeting, and how long words
    fly between each pair. Bars wear the participants' system colours. %>
<tr class="relativistic-details" id="relativistic-<%= dom_id(meeting) %>" style="display: none;">
  <td colspan="<%= show_system_column ? 6 : 5 %>">
    <div class="relativistic-info-container rel-panel">
      <section class="rel-part">
        <h4>Kolik ze schůzky kdo prožije</h4>
        <p class="rel-lead">
          Naplánovaných <strong><%= base_duration.round %> min</strong> uběhne každému jinak rychle, podle toho,
          jak silná gravitace ho drží<% if is_inter_system %> (vlastní těleso i černá díra)<% end %>.
        </p>

        <ul class="rel-list">
          <% participants.each do |participant_name| %>
            <% info = participant_info[participant_name] %>
            <% dilation = info[:dilation] %>
            <li class="rel-row" style="--rel-color: <%= system_color(info[:system_id]) %>;">
              <%# The dot's colour is the participant's system (named in the tooltip) %>
              <span class="rel-name" title="<%= info[:system]&.name %>">
                <span class="rel-dot" aria-hidden="true"></span><%= participant_name %>
              </span>
              <span class="rel-bar-track"><span class="rel-bar" style="width: <%= (dilation * 100).clamp(0, 100).round(1) %>%;"></span></span>
              <span class="rel-value"><%= format_minutes(base_duration * dilation) %> min</span>
            </li>
          <% end %>
        </ul>
      </section>

      <section class="rel-part">
        <h4>Jak dlouho k sobě letí slova</h4>
        <p class="rel-lead">
          Signál letí rychlostí světla<% if is_inter_system %>, mezi soustavami desítky sekund<% end %>.
          Průměrně <strong><%= meeting.avg_delay ? format_delay_display(meeting.avg_delay) : "?" %></strong> na jednu větu.
        </p>

        <% if pair_delays.any? %>
          <% if grouped %>
            <p class="rel-hint">Spojení po soustavách, průměrné zpoždění:</p>
          <% end %>
          <ul class="rel-list rel-list--pairs<%= " rel-list--grouped" if grouped %>">
            <% delay_rows.each do |row| %>
              <li class="rel-row" style="--rel-color: <%= system_color(row[:from_id]) %>; --rel-color-to: <%= system_color(row[:to_id]) %>;">
                <span class="rel-name" title="<%= row[:label] %>"><%= row[:label] %><% if row[:count] %> <small class="rel-system"><%= cs_count(row[:count], "spojení", "spojení", "spojení") %></small><% end %></span>
                <span class="rel-bar-track"><span class="rel-bar rel-bar--pair" style="width: <%= max_row_delay&.positive? ? (row[:delay] / max_row_delay * 100).round(1) : 0 %>%;"></span></span>
                <span class="rel-value"><%= format_delay_display(row[:delay]) %></span>
              </li>
            <% end %>
          </ul>
          <% if hidden_pairs.positive? %>
            <p class="rel-footnote">Nejdelší spojení, dalších <%= hidden_pairs %> je kratších.</p>
          <% end %>
        <% else %>
          <p class="rel-footnote">Zpoždění nelze spočítat, chybí data účastníků.</p>
        <% end %>
      </section>
    </div>
  </td>
</tr>
