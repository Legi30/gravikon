<%
  is_inter_system = local_assigns.fetch(:is_inter_system, false)
  show_system_column = local_assigns.fetch(:show_system_column, false)
  calculator = @relativistic_calculator || RelativisticCalculator.new
  base_duration = meeting.duration_minutes
  participant_systems_hash = meeting.participant_systems_hash

  # Resolve each participant's system and body data once
  participants = meeting.participants_array
  participant_info = {}
  participants.each do |name|
    system_id = if is_inter_system && participant_systems_hash.present?
      participant_systems_hash[name]
    else
      meeting.system_id
    end
    system = system_id ? (@systems_by_id&.dig(system_id) || System.find_by(id: system_id)) : nil
    body = system&.load_system_data&.dig("bodies")&.find { |b| b["name"] == name }
    participant_info[name] = { system_id: system_id, system: system, body: body }
  end

  # Pairwise signal delays (seconds)
  pair_delays = participants.combination(2).filter_map do |p1, p2|
    i1 = participant_info[p1]
    i2 = participant_info[p2]
    next unless i1[:system_id] && i2[:system_id] && i1[:body] && i2[:body]

    distance = calculator.calculate_body_to_body_distance(i1[:body], i1[:system_id], i2[:body], i2[:system_id])
    { p1: p1, p2: p2, delay: calculator.calculate_signal_delay(distance) }
  end
  max_delay = pair_delays.map { |pair| pair[:delay] }.max
%>
<tr class="relativistic-details" id="relativistic-<%= dom_id(meeting) %>" style="display: none;">
  <td colspan="<%= show_system_column ? 7 : 6 %>">
    <div class="relativistic-info-container">
      <h4>Relativistické efekty<% if is_inter_system %> - Mezisystémová schůzka<% end %></h4>

      <!-- Time Dilation -->
      <div class="relativistic-section">
        <h5>⏱ Časová dilatace</h5>
        <p class="explanation">
          Gravitace způsobuje, že čas běží různě rychle na různých tělesech.
          Plánovaných <strong><%= base_duration.round %> min</strong> trvá pro každého účastníka jinak dlouho:
        </p>

        <div class="rel-grid rel-grid-dilation">
          <span class="rel-head">Účastník</span>
          <span class="rel-head"></span>
          <span class="rel-head rel-num">Lokální čas</span>
          <span class="rel-head rel-num">Dilatace</span>

          <% participants.each do |participant_name| %>
            <%
              info = participant_info[participant_name]
              dilation = calculator.calculate_time_dilation(info[:body], info[:system_id])
              local_duration = base_duration * dilation
              color_value = ((1.0 - dilation) * 255).to_i.clamp(0, 255)
              bar_color = "rgb(#{color_value}, #{255 - color_value}, 50)"
            %>
            <span class="rel-name">
              <%= participant_name %>
              <% if is_inter_system && info[:system] %>
                <small class="rel-system">(<%= info[:system].name %>)</small>
              <% end %>
            </span>
            <span class="rel-bar-track">
              <span class="rel-bar" style="width: <%= (dilation * 100).clamp(0, 100).round(1) %>%; background-color: <%= bar_color %>;"></span>
            </span>
            <span class="rel-num rel-value"><%= local_duration.round(2) %> min</span>
            <span class="rel-num rel-factor"><%= dilation.round(4) %>×</span>
          <% end %>
        </div>

        <% if is_inter_system %>
          <p class="rel-footnote">
            Dilatační faktor kombinuje lokální gravitaci hvězdy a gravitaci centrální černé díry
            (výsledná dilatace = lokální × galaxiová).
          </p>
        <% end %>
      </div>

      <!-- Signal Delay -->
      <div class="relativistic-section">
        <h5>📡 Zpoždění signálu</h5>
        <p class="explanation">
          Světlo má konečnou rychlost, signál mezi účastníky proto dorazí se zpožděním<% if is_inter_system %> — mezi soustavami výrazně větším<% end %>:
        </p>

        <% if pair_delays.any? %>
          <div class="rel-grid rel-grid-delay">
            <span class="rel-head">Spojení</span>
            <span class="rel-head"></span>
            <span class="rel-head rel-num">Zpoždění</span>

            <% pair_delays.each do |pair| %>
              <span class="rel-name">
                <%= pair[:p1] %> ↔ <%= pair[:p2] %>
                <% if is_inter_system && participant_info[pair[:p1]][:system_id] != participant_info[pair[:p2]][:system_id] %>
                  <small class="rel-system" title="Mezisystémové spojení">🌌</small>
                <% end %>
              </span>
              <span class="rel-bar-track">
                <span class="rel-bar rel-bar-delay" style="width: <%= max_delay&.positive? ? (pair[:delay] / max_delay * 100).round(1) : 0 %>%;"></span>
              </span>
              <span class="rel-num rel-value"><%= pair[:delay].round(2) %> s</span>
            <% end %>
          </div>

          <p class="rel-summary">
            Průměrné zpoždění: <strong><%= meeting.avg_delay ? "#{meeting.avg_delay.round(2)} s" : "?" %></strong>
          </p>
        <% else %>
          <p class="rel-footnote">Zpoždění nelze spočítat — chybí data účastníků.</p>
        <% end %>
      </div>

      <!-- Explanation Footer -->
      <div class="relativistic-footer">
        <small>
          <strong>💡 Vysvětlení:</strong>
          Časová dilatace je efekt obecné relativity — čas běží pomaleji blíže masivním objektům.
          Zpoždění signálu je způsobeno konečnou rychlostí světla.
        </small>
      </div>
    </div>
  </td>
</tr>
