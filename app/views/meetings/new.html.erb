<div class="page-header">
  <h1>Nová schůzka<% if @system.present? %> - <%= @system.name %><% end %></h1>
</div>

<% if @systems.present? && @systems.count >= 2 && @system.blank? %>
  <div class="content-section">
    <div class="card fade-in">
      <h3>Vyberte soustavu pro schůzku</h3>
      <p>Pro vytvoření schůzky v rámci jedné soustavy vyberte soustavu níže. Pro schůzku mezi soustavami použijte mezisystémový režim.</p>

      <div class="systems-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; margin-top: 1.5rem;">
        <% @systems.each do |system| %>
          <div class="system-card" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 1.25rem; transition: all 0.3s ease;">
            <h4 style="margin: 0 0 0.75rem 0; color: var(--accent);"><%= system.name %></h4>
            <% system_data = system.load_system_data %>
            <% if system_data %>
              <p style="font-size: 0.9rem; color: rgba(255, 255, 255, 0.7); margin-bottom: 1rem;">
                Počet těles: <%= system_data['bodies']&.count || 0 %>
              </p>
            <% end %>
            <%= link_to "Vybrat tuto soustavu", new_meeting_path(system_id: system.id), class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </div>

      <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid rgba(255, 255, 255, 0.1);">
        <%= link_to "🌌 Nebo vytvořit mezisystémovou schůzku", new_inter_system_meetings_path, class: "btn btn-accent" %>
      </div>
    </div>
  </div>
<% else %>

<div class="content-section">
  <div class="card fade-in">
    <%= form_with url: meetings_path, method: :post, scope: :meeting, aria: { label: "Formulář pro plánování nové schůzky" } do |f| %>
      <% if @system.present? %>
        <%= f.hidden_field :system_id, value: @system.id %>
      <% end %>

      <div class="form-group">
        <%= f.label :start_time, "Začátek (např. 12:00):", for: "meeting_start_time" %>
        <%= f.text_field :start_time, value: params.dig(:meeting, :start_time), placeholder: "12:00", id: "meeting_start_time", aria: { describedby: "start-time-error", required: "true" } %>
        <div id="start-time-error" class="error-message" style="display: none;" role="alert" aria-live="polite"></div>
      </div>

      <div class="form-group">
        <%= f.label :end_time, "Konec (např. 13:30):", for: "meeting_end_time" %>
        <%= f.text_field :end_time, value: params.dig(:meeting, :end_time), placeholder: "13:30", id: "meeting_end_time", aria: { describedby: "end-time-error duration-display", required: "true" } %>
        <div id="end-time-error" class="error-message" style="display: none;" role="alert" aria-live="polite"></div>
        <div id="duration-display" class="success-message" style="display: none;" role="status" aria-live="polite"></div>
      </div>

      <div class="form-group">
        <%= f.label :topic, "Téma (volitelné):", for: "meeting_topic" %>
        <%= f.text_field :topic, value: params.dig(:meeting, :topic), placeholder: "Diskuse o gravitaci...", id: "meeting_topic" %>
      </div>

      <div class="form-group">
        <fieldset>
          <legend>Účastníci (vyberte alespoň 2)<% if @system.present? %> z <%= @system.name %><% end %>:</legend>
          <div class="checkbox-group" role="group" aria-describedby="participants-error">
            <% selected_participants = Array(params.dig(:meeting, :participants)) %>
            <% @bodies.each_with_index do |name, index| %>
              <label class="checkbox-label" for="participant_<%= index %>">
                <%= check_box_tag "meeting[participants][]", name, selected_participants.include?(name), id: "participant_#{index}", aria: { required: index < 2 ? "true" : "false" } %>
                <%= name %>
              </label>
            <% end %>
          </div>
          <div id="participants-error" class="error-message" style="display: none;" role="alert" aria-live="polite"></div>
        </fieldset>
      </div>

      <div class="actions">
        <%= f.submit "Naplánovat", class: "btn btn-primary" %>
        <%= link_to "Zrušit", meetings_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Include meeting form validation JavaScript -->
<script src="<%= asset_path('meeting_form.js') %>"></script>

<% end %>
