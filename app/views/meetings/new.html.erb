<div class="page-header">
  <h1>Nová schůzka</h1>
</div>

<div class="content-section">
  <div class="card fade-in">
    <%= form_with url: meetings_path, method: :post, scope: :meeting, aria: { label: "Formulář pro plánování nové schůzky" } do |f| %>
      <div class="form-group">
        <%= f.label :start_time, "Začátek (např. 12:00):", for: "meeting_start_time" %>
        <%= f.text_field :start_time, placeholder: "12:00", id: "meeting_start_time", aria: { describedby: "start-time-error", required: "true" } %>
        <div id="start-time-error" class="error-message" style="display: none;" role="alert" aria-live="polite"></div>
      </div>

      <div class="form-group">
        <%= f.label :end_time, "Konec (např. 13:30):", for: "meeting_end_time" %>
        <%= f.text_field :end_time, placeholder: "13:30", id: "meeting_end_time", aria: { describedby: "end-time-error duration-display", required: "true" } %>
        <div id="end-time-error" class="error-message" style="display: none;" role="alert" aria-live="polite"></div>
        <div id="duration-display" class="success-message" style="display: none;" role="status" aria-live="polite"></div>
      </div>

      <div class="form-group">
        <%= f.label :topic, "Téma (volitelné):", for: "meeting_topic" %>
        <%= f.text_field :topic, placeholder: "Diskuse o gravitaci...", id: "meeting_topic" %>
      </div>

      <div class="form-group">
        <fieldset>
          <legend>Účastníci (vyberte alespoň 2):</legend>
          <div class="checkbox-group" role="group" aria-describedby="participants-error">
            <% @bodies.each_with_index do |name, index| %>
              <label class="checkbox-label" for="participant_<%= index %>">
                <%= check_box_tag "meeting[participants][]", name, false, id: "participant_#{index}", aria: { required: index < 2 ? "true" : "false" } %>
                <%= name %>
              </label>
            <% end %>
          </div>
          <div id="participants-error" class="error-message" style="display: none;" role="alert" aria-live="polite"></div>
        </fieldset>
      </div>

      <div class="actions">
        <%= f.submit "Naplánovat", class: "btn btn-primary" %>
        <%= link_to "Zrušit", meetings_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Include meeting form validation JavaScript -->
<script src="<%= asset_path('meeting_form.js') %>"></script>
