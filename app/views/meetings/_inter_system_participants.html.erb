<%# Participant picker for inter-system meetings.
    locals:
      systems_with_bodies - Hash of system_id => { system:, bodies: }
      selected_names      - Array of participant names to pre-check %>
<% selected_names = local_assigns.fetch(:selected_names, []) %>

<fieldset>
  <legend>Kdo se sejde? <small>Vyberte alespoň dva účastníky ze dvou různých soustav.</small></legend>

  <div id="participants-error" class="error-message" style="display: none; margin-bottom: 1rem;" role="alert" aria-live="polite"></div>

  <% systems_with_bodies.each do |system_id, system_info| %>
    <div class="system-participant-group" style="--system-color: <%= system_color(system_id) %>; --system-tint: <%= system_tint(system_id) %>;">
      <h4 class="participant-group-name">
        <span class="system-dot" aria-hidden="true"></span><%= system_info[:system].name %>
      </h4>

      <div class="checkbox-group participant-grid" role="group">
        <% system_info[:bodies].each_with_index do |body, index| %>
          <% checked = selected_names.include?(body['name']) %>
          <% field_id = "ps_field_#{system_id}_#{index}" %>
          <label class="checkbox-label participant-tile" for="participant_<%= system_id %>_<%= index %>">
            <%= check_box_tag "meeting[participants][]", body['name'], checked,
                id: "participant_#{system_id}_#{index}",
                class: "participant-checkbox",
                data: {
                  system_id: system_id,
                  body_name: body['name'],
                  ps_field: field_id
                },
                aria: { required: "false" } %>
            <%= hidden_field_tag "meeting[participant_systems][#{body['name']}]", system_id, id: field_id, disabled: !checked %>
            <span><%= body['name'] %></span>
            <small class="participant-type"><%= { "star" => "hvězda", "planet" => "planeta", "moon" => "měsíc" }[body['type']] %></small>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <div id="selection-summary" style="display: none;">
    <strong>Vybraní účastníci:</strong>
    <div id="summary-content" style="margin-top: 0.5rem;"></div>
  </div>
</fieldset>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('inter-system-meeting-form');
    if (!form) return;

    const checkboxes = Array.from(form.querySelectorAll('.participant-checkbox'));
    const summaryDiv = document.getElementById('selection-summary');
    const summaryContent = document.getElementById('summary-content');
    const participantsError = document.getElementById('participants-error');
    const submitBtn = document.getElementById('submit-btn');

    function updateSelectionSummary() {
      const selected = checkboxes.filter(cb => cb.checked);
      const systemIds = new Set(selected.map(cb => cb.dataset.systemId));

      // Each checkbox carries the id of its own hidden participant_systems
      // field — only checked participants submit their system mapping.
      checkboxes.forEach(cb => {
        const field = document.getElementById(cb.dataset.psField);
        if (field) field.disabled = !cb.checked;
      });

      if (selected.length === 0) {
        summaryDiv.style.display = 'none';
        participantsError.style.display = 'none';
        return;
      }

      // Group by system
      const bySystem = {};
      selected.forEach(cb => {
        const sysId = cb.dataset.systemId;
        if (!bySystem[sysId]) {
          bySystem[sysId] = {
            name: cb.closest('.system-participant-group').querySelector('h4').textContent.trim().split('\n')[0].replace('🪐', '').trim(),
            bodies: []
          };
        }
        bySystem[sysId].bodies.push(cb.dataset.bodyName);
      });

      // Build summary
      let summaryHTML = '<ul style="margin: 0; padding-left: 1.5rem;">';
      Object.values(bySystem).forEach(sys => {
        summaryHTML += `<li><strong>${sys.name}:</strong> ${sys.bodies.join(', ')}</li>`;
      });
      summaryHTML += '</ul>';
      summaryContent.innerHTML = summaryHTML;
      summaryDiv.style.display = 'block';

      // Validation
      if (selected.length < 2) {
        participantsError.textContent = 'Vyberte alespoň 2 účastníky.';
        participantsError.style.display = 'block';
        if (submitBtn) submitBtn.disabled = true;
      } else if (systemIds.size < 2) {
        participantsError.textContent = 'Pro mezisystémovou schůzku musí být účastníci alespoň ze 2 různých soustav.';
        participantsError.style.display = 'block';
        if (submitBtn) submitBtn.disabled = true;
      } else {
        participantsError.style.display = 'none';
        if (submitBtn) submitBtn.disabled = false;
      }
    }

    checkboxes.forEach(cb => {
      cb.addEventListener('change', updateSelectionSummary);
    });

    // Form submission validation
    form.addEventListener('submit', function(e) {
      const selected = checkboxes.filter(cb => cb.checked);
      const systemIds = new Set(selected.map(cb => cb.dataset.systemId));

      if (selected.length < 2 || systemIds.size < 2) {
        e.preventDefault();
        participantsError.textContent = 'Vyberte alespoň 2 účastníky ze 2 různých soustav.';
        participantsError.style.display = 'block';
        participantsError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return false;
      }
    });

    // Initial state
    updateSelectionSummary();
  });
</script>

