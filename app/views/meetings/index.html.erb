<div class="page-header">
  <h1>Naplánované schůzky</h1>
</div>

<div id="flash-messages" role="alert" aria-live="polite" aria-atomic="true"></div>

<div class="content-section">
  <div class="card fade-in meetings-toolbar">
    <div class="meetings-filter">
      <% if @systems.present? && @systems.count > 1 %>
        <label for="system-filter" style="margin-bottom: 0.5rem;">Podle soustavy:</label>
        <select id="system-filter" class="form-control" style="min-width: 220px;" aria-label="Filtrovat podle soustavy">
          <option value="">Všechny schůzky</option>
          <option value="inter-system">Pouze mezisystémové</option>
          <option value="single-system">Pouze v rámci soustavy</option>
          <% @systems.each do |system| %>
            <option value="system-<%= system.id %>"><%= system.name %></option>
          <% end %>
        </select>
      <% end %>
    </div>

    <div class="meetings-toolbar-actions">
      <%= link_to "Naplánovat novou schůzku", new_meeting_path, class: "btn btn-primary", "aria-label" => "Naplánovat novou schůzku - klávesová zkratka N", title: "Naplánovat novou schůzku (klávesová zkratka: N)" %>
      <% if @systems.present? && @systems.count >= 2 %>
        <%= link_to "🌌 Mezisystémová schůzka", new_inter_system_meetings_path, class: "btn btn-accent", "aria-label" => "Naplánovat schůzku mezi soustavami" %>
      <% end %>
    </div>
  </div>
</div>

<style>
  .meetings-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 1.25rem 1.5rem;
  }

  .meetings-filter {
    display: flex;
    flex-direction: column;
  }

  .meetings-filter select {
    width: auto;
  }

  .meetings-toolbar-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
</style>

<div class="content-section">
  <div class="card fade-in">
    <table role="table" aria-label="Seznam naplánovaných schůzek">
      <thead>
        <tr>
          <th scope="col">Čas</th>
          <th scope="col">Účastníci</th>
          <th scope="col">Téma</th>
          <% if @systems.present? && @systems.count > 0 %>
            <th scope="col">Soustava</th>
          <% end %>
          <th scope="col"><abbr title="Průměrná délka schůzky v lokálním čase účastníků. Kvůli gravitační dilataci času — důsledku zakřivení časoprostoru hmotnými tělesy (obecná relativita) — plyne čas každému účastníkovi jinak rychle, takže schůzka pro ně trvá jinak dlouho než v plánovaném čase." aria-label="Průměrná délka">⏱ Průměrná délka</abbr></th>
          <th scope="col"><abbr title="Průměrné zpoždění signálu mezi účastníky. Světlo (a tedy každý signál) má konečnou rychlost, takže komunikace mezi vzdálenými tělesy dorazí se zpožděním — u mezisystémových schůzek výrazně větším." aria-label="Zpoždění signálu">📡 Zpoždění</abbr></th>
          <th scope="col">Akce</th>
        </tr>
      </thead>
      <tbody id="meetings-table">
        <%= render partial: 'meeting', collection: @meetings, locals: { show_system_column: (@systems.present? && @systems.count > 0) } %>
      </tbody>
    </table>

    <div id="empty-state-container">
      <% if @meetings.empty? %>
        <div class="empty-state" role="status">
          <p>Zatím nebyly naplánovány žádné schůzky.</p>
          <p>
            <%= link_to "Vytvořit první schůzku", new_meeting_path, class: "btn btn-primary", "aria-label" => "Vytvořit první schůzku" %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Include relativistic visualization JavaScript -->
<script src="<%= asset_path('relativistic_viz.js') %>"></script>

<% if @systems.present? && @systems.count > 1 %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const filterSelect = document.getElementById('system-filter');
    const meetingsTable = document.getElementById('meetings-table');

    if (filterSelect && meetingsTable) {
      filterSelect.addEventListener('change', function() {
        const filterValue = this.value;
        const rows = meetingsTable.querySelectorAll('tr[id^="meeting_"]');

        rows.forEach(function(row) {
          const isInterSystem = row.dataset.isInterSystem === 'true';
          const systemId = row.dataset.systemId;

          let shouldShow = true;

          if (filterValue === 'inter-system') {
            shouldShow = isInterSystem;
          } else if (filterValue === 'single-system') {
            shouldShow = !isInterSystem;
          } else if (filterValue.startsWith('system-')) {
            const targetSystemId = filterValue.replace('system-', '');
            shouldShow = systemId === targetSystemId || (isInterSystem && row.dataset.systemIds && row.dataset.systemIds.includes(targetSystemId));
          }

          // Show/hide the meeting row and its relativistic info row
          if (shouldShow) {
            row.style.display = '';
            const relativisticRow = document.getElementById('relativistic-' + row.id);
            if (relativisticRow) {
              relativisticRow.style.display = relativisticRow.classList.contains('open') ? 'table-row' : 'none';
            }
          } else {
            row.style.display = 'none';
            const relativisticRow = document.getElementById('relativistic-' + row.id);
            if (relativisticRow) {
              relativisticRow.style.display = 'none';
            }
          }
        });
      });
    }
  });
</script>
<% end %>
